import { Button, CheckBox, ComboBox, LineEdit, ListView, StandardTableView, Switch, Spinner, ScrollView, Palette, TextEdit } from "std-widgets.slint";

export struct AccountRow {
    name: string,
    initial: string,
    kind: string,
    status: string,
    tone: int, // 0 ok, 1 busy, 2 problem, 3 off
}

// One of the advanced client options (advanced.rs)
export struct AdvRow {
    group: string,
    label: string,
    hint: string,
    kind: int, // 0 on/off, 1 number, 2 text, 3 choice
    checked: bool,
    text: string,
    unit: string,
    placeholder: string,
    choices: [string],
    choice: int,
    // the client's defaults, for "Reset to default" and the changed dot
    default-checked: bool,
    default-text: string,
    default-choice: int,
    risky: bool,
    effect: int, // 0 restart, 1 needs a full resync, 2 needs signing in again
    needs: int, // row that must be on for this one to matter; -1 none, -2 the Trash option
    matched: bool, // matches the search
    error: string,
}

// A desktop folder that can be backed up into OneDrive (backup.rs)
export struct BackupRow {
    label: string,
    detail: string, // where it is, or why it can't be backed up
    state: int, // 0 can be backed up, 1 backed up here, 2 backed up by another account, 3 unavailable
}

// A file changed both here and online (conflict.rs)
export struct ConflictRow {
    name: string,
    detail: string, // folder, and when this computer's copy was saved
}

// A small coloured label: "Can lose data", "Full resync"…
component Badge inherits Rectangle {
    in property <string> text;
    in property <brush> tone;
    height: 20px;
    width: badge-text.preferred-width + 14px;
    border-radius: 10px;
    background: tone.with-alpha(Theme.dark ? 0.22 : 0.14);
    badge-text := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: tone;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export struct FolderRow {
    name: string,
    depth: int,
    expanded: bool,
    has-children: bool,
    loading: bool,
    checked: bool,
    inherited: bool,
}

// The look, matched to the desktop: light/dark and the accent colour follow the desktop's own
// settings (Palette picks up the accent by itself), and `glass` makes the window see-through so
// the desktop can blur what's behind it. ui.rs only turns glass on where the desktop does that.
export global Theme {
    in property <bool> dark;
    in property <bool> glass;
    // the desktop asks for higher contrast: solid surfaces, firmer borders and text
    in property <bool> contrast;
    // the desktop has animations switched off
    in property <bool> reduce-motion;
    out property <duration> quick: reduce-motion ? 0ms : 120ms;
    out property <duration> slide: reduce-motion ? 0ms : 180ms;
    out property <brush> accent: Palette.accent-background;
    // clear under glass, so the desktop's blur shows through the sidebar and the page
    out property <brush> window: glass ? transparent : dark ? #1a1a1f : #eef0f4;
    out property <brush> sidebar: glass ? (dark ? #15151bb3 : #eef0f5a6) : (dark ? #1a1a1f : #eceef2);
    out property <brush> pane: glass ? (dark ? #1d1d23eb : #fafbfdeb) : (dark ? #212127 : #fafbfd);
    out property <brush> divider: contrast ? Palette.foreground.with-alpha(0.5) : dark ? #ffffff14 : #00000012;
    out property <brush> card: dark ? #ffffff0b : #ffffff;
    out property <brush> card-border: contrast ? Palette.foreground.with-alpha(0.6) : dark ? #ffffff14 : #0000000f;
    out property <color> card-shadow: dark ? transparent : #00000014;
    out property <brush> dialog: dark ? #26262e : #ffffff;
    out property <brush> hover: dark ? #ffffff0f : #0000000a;
    out property <brush> selected: Palette.accent-background.with-alpha(contrast ? 0.45 : dark ? 0.30 : 0.16);
    out property <brush> track: dark ? #ffffff1a : #00000012;
    out property <brush> subtle-text: Palette.foreground.with-alpha(contrast ? 0.9 : 0.64);
    out property <color> ok: dark ? #3dd68c : #1f9d55;
    out property <color> problem: dark ? #ff6b6b : #d93636;
    out property <color> off: dark ? #8b8b96 : #9a9aa4;
    out property <color> warn: dark ? #f5b83d : #c98a00;

    // tone: 0 ok, 1 busy, 2 problem, 3 off (as in AccountRow)
    public pure function tone-color(tone: int) -> brush {
        tone == 0 ? ok : tone == 1 ? accent : tone == 2 ? problem : off
    }
}

component Title inherits Text {
    font-size: 22px;
    font-weight: 700;
    overflow: elide;
}

component Heading inherits Text {
    font-size: 14px;
    font-weight: 600;
}

component Hint inherits Text {
    wrap: word-wrap;
    font-size: 12px;
    color: Theme.subtle-text;
}

component ToneDot inherits Rectangle {
    in property <int> tone;
    width: 10px;
    height: 10px;
    border-radius: self.width / 2;
    background: Theme.tone-color(tone);
    animate background { duration: Theme.quick; }
}

// A round badge with the account's first letter, and its status dot in the corner.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <int> tone: -1; // no dot below 0
    in property <length> size: 34px;
    width: size;
    height: size;
    Rectangle {
        border-radius: self.width / 2;
        background: Theme.accent.with-alpha(Theme.dark ? 0.32 : 0.15);
        Text {
            text: root.initial;
            font-size: root.size * 0.44;
            font-weight: 700;
            color: Theme.dark ? Palette.foreground : Theme.accent;
        }
    }
    if root.tone >= 0: Rectangle {
        x: parent.width - self.width + 1px;
        y: parent.height - self.height + 1px;
        width: 13px;
        height: 13px;
        border-radius: self.width / 2;
        background: Theme.tone-color(root.tone);
        border-width: 2px;
        border-color: Theme.dark ? #1a1a1f : #ffffff;
    }
}

// A row in the sidebar below the accounts, with a small drawn icon (0 plus, 1 settings).
component NavRow inherits Rectangle {
    in property <string> text;
    in property <int> icon;
    in property <bool> selected;
    in property <bool> emphasised;
    callback clicked();
    height: 38px;
    border-radius: 10px;
    background: selected ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => {
        root.clicked();
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    // reachable with Tab and pressed with Space or Enter, like the buttons these replace
    fs := FocusScope {
        x: 0;
        width: 0; // clicks go to the TouchArea
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 10px;
        spacing: 12px;
        alignment: start;
        Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            background: root.emphasised ? Theme.accent : Theme.hover;
            property <brush> ink: root.emphasised ? Palette.accent-foreground : Palette.foreground.with-alpha(0.75);
            if root.icon == 0: Rectangle {
                width: 10px;
                height: 2px;
                background: parent.ink;
            }
            if root.icon == 0: Rectangle {
                width: 2px;
                height: 10px;
                background: parent.ink;
            }
            // settings: three slider lines with their knobs
            for k[i] in [4px, 9px, 6px]: Rectangle {
                x: 6px;
                y: 7px + i * 4px;
                width: root.icon == 1 ? 12px : 0;
                height: 1.5px;
                background: parent.ink;
                Rectangle {
                    x: k - 1.5px;
                    y: -1.25px;
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: parent.background;
                    visible: root.icon == 1;
                }
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-weight: root.selected ? 600 : 400;
        }
    }
}

// The tabs of an account: a segmented control whose highlight slides to the chosen tab.
component Segmented inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> current;
    height: 34px;
    border-radius: 10px;
    background: Theme.dark ? #ffffff0d : #0000000b;
    property <length> seg: (self.width - 6px) / labels.length;
    Rectangle {
        x: 3px + root.current * root.seg;
        y: 3px;
        width: root.seg;
        height: parent.height - 6px;
        border-radius: 8px;
        background: Theme.dark ? #ffffff1f : #ffffff;
        drop-shadow-blur: Theme.dark ? 0px : 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000024;
        border-width: fs.has-focus ? 2px : 0;
        border-color: Theme.accent;
        animate x { duration: Theme.slide; easing: ease-out; }
    }
    // reachable with Tab; the arrow keys move between the tabs
    fs := FocusScope {
        x: 0;
        width: 0; // clicks go to the tabs' TouchAreas
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                root.current = max(0, root.current - 1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.current = min(root.labels.length - 1, root.current + 1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.current = 0;
                return accept;
            }
            if (event.text == Key.End) {
                root.current = root.labels.length - 1;
                return accept;
            }
            return reject;
        }
    }
    for label[i] in root.labels: Rectangle {
        x: 3px + i * root.seg;
        y: 3px;
        width: root.seg;
        height: parent.height - 6px;
        accessible-role: tab;
        accessible-label: label;
        accessible-action-default => {
            root.current = i;
        }
        TouchArea {
            clicked => {
                root.current = i;
            }
        }
        Text {
            text: label;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-weight: root.current == i ? 600 : 400;
            color: root.current == i ? Palette.foreground : Theme.subtle-text;
        }
    }
}

component Card inherits Rectangle {
    border-radius: 12px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: Theme.dark ? 0px : 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.card-shadow;
}

// One of the choices in the uninstall dialog; works like a radio button.
component UninstallChoice inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    border-radius: 10px;
    border-width: selected ? 2px : 1px;
    border-color: fs.has-focus || selected ? Theme.accent : Theme.card-border;
    background: selected ? Theme.selected : area.has-hover && enabled ? Theme.hover : transparent;
    height: choice-layout.preferred-height;
    accessible-role: radio-button;
    accessible-label: root.title + ". " + root.detail;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.clicked();
        }
    }
    fs := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    choice-layout := HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 2px;
                border-color: root.selected ? Palette.accent-background : Palette.foreground.with-alpha(0.5);
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Palette.accent-background;
                    visible: root.selected;
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: root.title;
                font-weight: 600;
            }
            Hint {
                text: root.detail;
            }
        }
    }
}

// A large choice card that can be reached and activated without a mouse.
component ChoiceCard inherits Card {
    in property <string> title;
    in property <string> detail;
    callback clicked();
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.accent : Theme.card-border;
    accessible-role: button;
    accessible-label: root.title + ". " + root.detail;
    accessible-action-default => {
        root.clicked();
    }
    ta := TouchArea {
        clicked => {
            fs.focus();
            root.clicked();
        }
    }
    fs := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        Heading {
            text: root.title;
        }
        Hint {
            text: root.detail;
        }
    }
}

// Shown above every page while the OneDrive Client for Linux is missing or too old.
component ClientBanner inherits Rectangle {
    in property <string> problem;
    in property <string> hint;
    in property <bool> can-install;
    in property <bool> installing;
    in property <string> install-msg;
    // offering a newer client (Arch) rather than reporting a missing one
    in property <bool> update;
    callback instructions();
    callback recheck();
    callback install();
    callback not-now();
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.warn.with-alpha(0.6);
    background: Theme.warn.with-alpha(0.13);
    height: banner-layout.preferred-height;
    banner-layout := VerticalLayout {
        padding: 12px;
        spacing: 6px;
        Text {
            text: root.problem;
            font-weight: 600;
            wrap: word-wrap;
        }
        if !root.update: Text {
            text: "This app needs one more free program, the OneDrive Client for Linux (version 2.5 or newer). It does the actual syncing in the background; this app is the window and tray icon for it.";
            wrap: word-wrap;
            font-size: 12px;
        }
        Hint {
            text: root.hint;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            if root.can-install: Button {
                text: root.installing ? (root.update ? "Updating…" : "Installing…") : (root.update ? "Update it for me" : "Install it for me");
                primary: true;
                enabled: !root.installing;
                clicked => {
                    root.install();
                }
            }
            if !root.update: Button {
                text: "Open installation instructions";
                clicked => {
                    root.instructions();
                }
            }
            if !root.update: Button {
                text: "Check again";
                enabled: !root.installing;
                clicked => {
                    root.recheck();
                }
            }
            if root.update: Button {
                text: "Not now";
                enabled: !root.installing;
                clicked => {
                    root.not-now();
                }
            }
        }
        if root.install-msg != "": Hint {
            text: root.install-msg;
        }
    }
}

// Shown while a sync service is switched on outside this app (for every user, or at boot).
component OutsideStartBanner inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> busy;
    callback turn-off();
    callback keep();
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.warn.with-alpha(0.6);
    background: Theme.warn.with-alpha(0.13);
    height: outside-layout.preferred-height;
    outside-layout := VerticalLayout {
        padding: 12px;
        spacing: 6px;
        Text {
            text: "Syncing is also set up outside this app";
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.text;
            wrap: word-wrap;
            font-size: 12px;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Button {
                text: root.busy ? "Turning it off…" : "Turn it off";
                enabled: !root.busy;
                clicked => {
                    root.turn-off();
                }
            }
            Button {
                text: "Leave it as it is";
                enabled: !root.busy;
                clicked => {
                    root.keep();
                }
            }
        }
        Hint {
            text: root.hint;
        }
    }
}

component Overlay inherits Rectangle {
    background: Theme.dark ? #0000008c : #00000052;
    TouchArea { }  // swallow clicks behind the dialog
}

export component AppWindow inherits Window {
    title: "DriveDeck for OneDrive";
    icon: @image-url("../assets/drivedeck.svg");
    preferred-width: 1020px;
    preferred-height: 700px;
    min-width: 780px;
    min-height: 540px;
    background: Theme.window;

    // ---------------- navigation
    in property <bool> dark;
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
        Theme.dark = self.dark;
    }
    init => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
        Theme.dark = self.dark;
    }

    in property <[AccountRow]> accounts;
    in-out property <int> current: -1; // >=0 account, -1 add account, -2 app settings
    in-out property <int> tab: 0;
    callback select(int);

    // ---------------- status tab
    in property <string> s-kind;
    in property <string> s-folder;
    in property <string> s-status;
    in property <int> s-tone;
    in property <string> s-last;
    in property <string> s-error;
    in property <string> s-quota;
    in property <float> s-quota-frac;
    in property <string> s-owner;
    in property <bool> s-signed-in;
    in property <bool> s-bg-enabled;
    in property <bool> s-busy;
    in property <string> s-msg;
    in-out property <string> s-name;
    callback rename();
    callback open-folder();
    callback move-folder(); // after the explanation: pick where
    // conflicting copies
    in property <[ConflictRow]> c-rows;
    callback c-open(int);
    callback c-settle(int, int); // 0 keep this computer's, 1 keep OneDrive's, 2 keep both
    // backing up desktop folders
    in property <[BackupRow]> b-rows;
    in property <bool> b-busy;
    callback b-start(int);
    callback b-stop(int);
    in-out property <bool> bk-visible;
    in property <string> bk-title;
    in property <string> bk-text;
    in property <string> bk-warn;
    in property <string> bk-action;
    callback bk-confirm();
    callback open-online-page(int); // 0 website, 1 recycle bin, 2 restore
    in property <bool> s-personal;
    in-out property <bool> mv-visible;
    in property <string> mv-from;
    callback sync-now();
    callback set-background(bool);
    callback sign-in();
    callback sign-out();
    callback remove-account();
    in property <bool> s-big-delete;
    in property <bool> s-allow-resync;
    callback big-delete-online();
    callback big-delete-restore();

    // ---------------- sign-in dialog
    in property <bool> si-visible;
    in property <string> si-text;
    in property <bool> si-need-paste;
    in property <bool> si-has-url;
    in property <bool> si-done;
    in-out property <string> si-paste;
    callback si-open-url();
    callback si-copy-url();
    callback si-submit();
    callback si-close();

    // ---------------- folders tab
    in-out property <bool> f-sync-all;
    in-out property <bool> f-root-files;
    in property <[FolderRow]> f-rows;
    in property <string> f-msg;
    in property <bool> f-loading;
    in property <bool> f-dirty;
    in property <bool> f-allowed;
    callback f-sync-all-toggled();
    callback f-root-toggled();
    callback f-expand(int);
    callback f-check(int);
    callback f-reload();
    callback f-apply();

    // ---------------- options tab
    in-out property <int> o-interval;
    in-out property <bool> o-sched-on;
    in-out property <string> o-from;
    in-out property <string> o-to;
    in-out property <int> o-rate;
    in-out property <bool> o-recycle;
    in-out property <bool> o-notify;
    in-out property <bool> o-skip-hidden;
    in-out property <string> o-skip-files;
    in-out property <bool> o-allow-resync;
    // 0 both ways, 1 download only, 2 upload only
    in-out property <int> o-direction;
    in-out property <bool> o-cleanup;
    in-out property <bool> o-keep-online;
    in-out property <string> o-skip-dirs;
    in-out property <bool> o-skip-symlinks;
    in-out property <bool> o-nosync;
    in property <bool> o-is-business;
    in-out property <bool> o-shared;
    in-out property <bool> o-ipv4;
    in property <string> o-msg;
    in-out property <string> o-big-delete;
    in-out property <bool> o-adv-open;
    in-out property <[AdvRow]> o-adv;
    in property <[string]> o-adv-groups;
    in-out property <int> o-adv-tab;
    in-out property <string> o-adv-query;
    in property <bool> o-adv-any-match;
    callback o-adv-search(string);
    callback o-save();
    callback o-show-config();
    callback o-open-logs();
    // the client's full running settings (--display-config)
    in-out property <bool> cfg-visible;
    in property <string> cfg-text;
    in property <bool> cfg-busy;

    // ---------------- activity tab
    in property <[[StandardListViewItem]]> a-rows;
    in-out property <int> a-current: -1;
    callback a-refresh();
    callback a-show(int);

    // ---------------- resync preview dialog
    in property <bool> p-visible;
    in property <bool> p-busy;
    in property <string> p-title;
    in property <string> p-text;
    in property <string> p-warn;
    in property <string> p-live;
    in property <bool> p-can-apply;
    callback p-apply();
    callback p-cancel();

    // ---------------- remove dialog
    in property <bool> r-visible;
    in property <string> r-text;
    in-out property <bool> r-delete-config: true;
    callback r-confirm();
    callback r-cancel();

    // ---------------- add account page
    in-out property <int> add-mode: 0; // 0 choose, 1 onedrive, 2 sharepoint
    in-out property <string> add-name;
    in-out property <string> add-folder;
    in-out property <int> add-cloud;
    in-out property <string> add-tenant;
    in property <string> add-msg;
    in property <bool> add-busy;
    in property <[string]> add-from;
    in-out property <int> add-from-index;
    in-out property <string> add-query;
    in property <[string]> add-libraries;
    in-out property <int> add-lib-index: -1;
    callback add-choose(int);
    callback add-browse();
    callback add-search();
    callback add-lib-picked(int);
    callback add-create();

    // ---------------- app page
    in-out property <bool> app-autostart;
    in property <string> app-version;
    in property <string> app-client;
    in property <bool> app-is-appimage;
    in property <string> app-msg;
    // glass: 0 automatic, 1 on, 2 off
    in-out property <int> app-glass;
    in property <string> app-glass-note;
    callback app-glass-changed();
    callback app-autostart-toggled();
    in-out property <bool> app-stop-on-quit;
    callback app-stop-on-quit-toggled();
    in-out property <bool> app-check-updates;
    callback app-check-updates-toggled();
    in-out property <bool> app-pause-metered;
    in-out property <bool> app-pause-saver;
    in-out property <bool> app-badges;
    in property <bool> app-dolphin-offer;
    in property <bool> app-dolphin-busy;
    in property <string> app-badges-msg;
    callback app-badges-toggled();
    callback app-dolphin-install();
    callback app-pause-toggled();
    // a newer version that's out, or ""
    in property <string> app-update;
    callback app-get-update();
    callback app-add-to-menu();
    callback open-url(string);

    // ---------------- uninstall dialog
    in property <bool> u-visible;
    in-out property <bool> u-keep-setup: true;
    in property <bool> u-busy;
    in property <string> u-result; // set when done
    in property <string> u-remove-app-label;
    callback app-uninstall();

    // ---------------- sync client check
    in property <string> client-problem; // empty when the client is fine
    in property <string> client-hint;
    in property <bool> client-can-install;
    in property <bool> client-installing;
    in property <string> client-install-msg;
    in property <bool> client-update;
    // "it's installed" note shown for a while after the banner goes away
    in property <string> client-done;
    callback client-done-ok();
    callback client-instructions();
    callback client-recheck();
    callback client-install();
    callback client-not-now();

    // ---------------- sync started outside this app (empty when there's none, or it was kept)
    in property <string> outside-start;
    in property <string> outside-start-hint;
    in property <bool> outside-start-busy;
    callback outside-start-off();
    callback outside-start-keep();

    // ---------------- "install the client" confirmation
    in property <bool> ci-visible;
    in property <string> ci-title;
    in property <string> ci-text;
    in property <string> ci-action;
    callback ci-confirm();
    callback ci-cancel();
    callback ci-myself();
    callback u-confirm();
    callback u-cancel();

    HorizontalLayout {
        width: root.width;
        height: root.height;

        // ======== sidebar
        Rectangle {
            width: 240px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 10px;
                padding-top: 14px;
                spacing: 4px;
                Text {
                    text: "Accounts";
                    x: 8px;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.subtle-text;
                }
                // the list scrolls on its own, so the rows below always stay in view
                ScrollView {
                    vertical-stretch: 0;
                    min-height: min(account-list.preferred-height, 120px);
                    preferred-height: account-list.preferred-height;
                    account-list := VerticalLayout {
                        spacing: 2px;
                        padding-top: 4px;
                        for acc[i] in root.accounts: Rectangle {
                            height: 52px;
                            border-radius: 10px;
                            background: root.current == i ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
                            border-width: fs.has-focus ? 2px : 0;
                            border-color: Theme.accent;
                            animate background { duration: Theme.quick; }
                            accessible-role: button;
                            accessible-label: acc.name + ", " + acc.status;
                            accessible-action-default => {
                                root.select(i);
                            }
                            ta := TouchArea {
                                clicked => {
                                    fs.focus();
                                    root.select(i);
                                }
                            }
                            fs := FocusScope {
                                x: 0;
                                width: 0;
                                key-pressed(event) => {
                                    if (event.text == Key.Space || event.text == Key.Return) {
                                        root.select(i);
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 10px;
                                alignment: start;
                                Avatar {
                                    initial: acc.initial;
                                    tone: acc.tone;
                                    y: (parent.height - self.height) / 2;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: acc.name;
                                        font-weight: 600;
                                        overflow: elide;
                                        width: 156px;
                                    }
                                    Text {
                                        text: acc.status;
                                        font-size: 11px;
                                        overflow: elide;
                                        width: 156px;
                                        color: Theme.subtle-text;
                                    }
                                }
                            }
                        }
                    }
                }
                NavRow {
                    text: "Add account";
                    icon: 0;
                    emphasised: root.accounts.length == 0;
                    selected: root.current == -1;
                    clicked => {
                        root.select(-1);
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                NavRow {
                    text: "App settings";
                    icon: 1;
                    selected: root.current == -2;
                    clicked => {
                        root.select(-2);
                    }
                }
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.divider;
        }

        // ======== main area
        Rectangle {
        horizontal-stretch: 1;
        background: Theme.pane;
        VerticalLayout {
            if root.client-problem == "" && root.client-done != "": VerticalLayout {
                padding: 12px;
                padding-bottom: 0px;
                Rectangle {
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.ok.with-alpha(0.55);
                    background: Theme.ok.with-alpha(0.13);
                    height: done-layout.preferred-height;
                    done-layout := HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: "✓  " + root.client-done;
                            font-weight: 600;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "OK";
                            clicked => {
                                root.client-done-ok();
                            }
                        }
                    }
                }
            }
            if root.client-problem != "": VerticalLayout {
                padding: 12px;
                padding-bottom: 0px;
                ClientBanner {
                    problem: root.client-problem;
                    hint: root.client-hint;
                    can-install: root.client-can-install;
                    installing: root.client-installing;
                    install-msg: root.client-install-msg;
                    update: root.client-update;
                    not-now => {
                        root.client-not-now();
                    }
                    instructions => {
                        root.client-instructions();
                    }
                    recheck => {
                        root.client-recheck();
                    }
                    install => {
                        root.client-install();
                    }
                }
            }
            if root.outside-start != "": VerticalLayout {
                padding: 12px;
                padding-bottom: 0px;
                OutsideStartBanner {
                    text: root.outside-start;
                    hint: root.outside-start-hint;
                    busy: root.outside-start-busy;
                    turn-off => {
                        root.outside-start-off();
                    }
                    keep => {
                        root.outside-start-keep();
                    }
                }
            }
            Rectangle {
            vertical-stretch: 1;

            // ---- account view
            if root.current >= 0: VerticalLayout {
                padding: 18px;
                padding-bottom: 6px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    Avatar {
                        initial: root.accounts[root.current].initial;
                        size: 46px;
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 1px;
                        Title {
                            text: root.accounts[root.current].name;
                        }
                        Text {
                            // the type, unless the name already says it, and whose account it is
                            text: root.s-kind == root.accounts[root.current].name ? root.s-owner : root.s-owner == "" ? root.s-kind : root.s-kind + "  ·  " + root.s-owner;
                            font-size: 12px;
                            color: Theme.subtle-text;
                            overflow: elide;
                        }
                    }
                    // status pill
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            border-radius: 14px;
                            background: Theme.tone-color(root.s-tone).with-alpha(Theme.dark ? 0.22 : 0.12);
                            width: pill.preferred-width;
                            pill := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 7px;
                                ToneDot {
                                    tone: root.s-tone;
                                    width: 8px;
                                    height: 8px;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: root.s-status;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    Segmented {
                        labels: ["Status", "Folders", "Options", "Activity"];
                        current <=> root.tab;
                        width: min(460px, parent.width);
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                        if root.tab == 0: ScrollView {
                            VerticalLayout {
                                padding: 2px;
                                padding-top: 4px;
                                padding-bottom: 14px;
                                spacing: 12px;
                                alignment: start;

                                if !root.s-signed-in: Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;
                                        Heading {
                                            text: "This account isn't signed in";
                                        }
                                        Hint {
                                            text: "Sign in with your Microsoft account. Your browser will open so you can log in, then you'll come back here automatically.";
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Sign in…";
                                                primary: true;
                                                clicked => {
                                                    root.sign-in();
                                                }
                                            }
                                        }
                                    }
                                }

                                Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Name";
                                                width: 120px;
                                                vertical-alignment: center;
                                            }
                                            LineEdit {
                                                accessible-label: "Account name";
                                                text <=> root.s-name;
                                                accepted => {
                                                    root.rename();
                                                }
                                            }
                                            Button {
                                                text: "Rename";
                                                clicked => {
                                                    root.rename();
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Type";
                                                width: 120px;
                                            }
                                            Text {
                                                text: root.s-kind + (root.s-owner != "" ? "  ·  " + root.s-owner : "");
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Folder";
                                                width: 120px;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: root.s-folder;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                            }
                                            Button {
                                                text: "Open";
                                                clicked => {
                                                    root.open-folder();
                                                }
                                            }
                                            Button {
                                                text: "Move…";
                                                enabled: !root.p-visible;
                                                clicked => {
                                                    root.mv-visible = true;
                                                }
                                            }
                                            if root.s-signed-in: Button {
                                                text: "Online ▾";
                                                clicked => {
                                                    online-pages.show({ x: self.absolute-position.x, y: self.absolute-position.y + self.height });
                                                }
                                            }
                                            online-pages := ContextMenuArea {
                                                enabled: false;
                                                width: 0;
                                                Menu {
                                                    MenuItem {
                                                        title: "OneDrive website";
                                                        activated => {
                                                            root.open-online-page(0);
                                                        }
                                                    }
                                                    MenuItem {
                                                        title: "Recycle bin";
                                                        activated => {
                                                            root.open-online-page(1);
                                                        }
                                                    }
                                                    if root.s-personal: MenuItem {
                                                        title: "Restore your OneDrive";
                                                        activated => {
                                                            root.open-online-page(2);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Last sync";
                                                width: 120px;
                                            }
                                            Text {
                                                text: root.s-last;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        if root.s-quota != "": VerticalLayout {
                                            spacing: 4px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: "Storage";
                                                    width: 120px;
                                                }
                                                Text {
                                                    text: root.s-quota;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                            Rectangle {
                                                height: 6px;
                                                border-radius: 3px;
                                                background: Theme.track;
                                                Rectangle {
                                                    x: 0;
                                                    width: parent.width * clamp(root.s-quota-frac, 0, 1);
                                                    border-radius: 3px;
                                                    // nearly full shows as a warning
                                                    background: root.s-quota-frac >= 1 ? Theme.problem : root.s-quota-frac >= 0.9 ? Theme.warn : Theme.accent;
                                                }
                                            }
                                        }
                                        if root.s-error != "": Text {
                                            text: root.s-error;
                                            color: Theme.problem;
                                            wrap: word-wrap;
                                        }
                                        if root.s-big-delete: HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Button {
                                                text: "Delete them online too…";
                                                enabled: !root.s-busy;
                                                clicked => {
                                                    root.big-delete-online();
                                                }
                                            }
                                            Button {
                                                text: "Download them again…";
                                                enabled: !root.s-busy && root.s-allow-resync;
                                                clicked => {
                                                    root.big-delete-restore();
                                                }
                                            }
                                        }
                                        if root.s-big-delete && !root.s-allow-resync: Hint {
                                            text: "Downloading them again needs a full resync, which is turned off for this account in Options.";
                                        }
                                    }
                                }

                                if root.s-signed-in: Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                Heading {
                                                    text: "Background sync";
                                                }
                                                Hint {
                                                    text: "Keeps this folder in sync all the time, including after you restart.";
                                                }
                                            }
                                            Switch {
                                                accessible-label: "Background sync";
                                                checked: root.s-bg-enabled;
                                                enabled: !root.s-busy;
                                                toggled => {
                                                    root.set-background(self.checked);
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Button {
                                                text: "Sync now";
                                                enabled: !root.s-busy;
                                                clicked => {
                                                    root.sync-now();
                                                }
                                            }
                                            Button {
                                                text: "Sign out";
                                                enabled: !root.s-busy;
                                                clicked => {
                                                    root.sign-out();
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.c-rows.length > 0: Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Heading {
                                                text: "Files changed in two places";
                                            }
                                            Badge {
                                                text: root.c-rows.length;
                                                tone: Theme.warn;
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        Hint {
                                            text: "These files were changed here and online before they could sync, so both versions were kept. Compare them, then choose which to keep.";
                                        }
                                        for c[i] in root.c-rows: Rectangle {
                                            height: 52px;
                                            border-radius: 10px;
                                            background: c-touch.has-hover ? Theme.hover : transparent;
                                            animate background { duration: Theme.quick; }
                                            c-touch := TouchArea { }
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 10px;
                                                Rectangle {
                                                    width: 34px;
                                                    height: 34px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 9px;
                                                    background: Theme.warn.with-alpha(0.18);
                                                    Image {
                                                        width: 18px;
                                                        height: 18px;
                                                        source: @image-url("../assets/ui/file-other.svg");
                                                        colorize: Theme.warn;
                                                    }
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 1px;
                                                    Text {
                                                        text: c.name;
                                                        font-weight: 600;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: c.detail;
                                                        font-size: 12px;
                                                        color: Theme.subtle-text;
                                                        overflow: elide;
                                                    }
                                                }
                                                // centred, not stretched to the row's height
                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        Button {
                                                            text: "Compare";
                                                            clicked => {
                                                                root.c-open(i);
                                                            }
                                                        }
                                                        Button {
                                                            text: "Keep… ▾";
                                                            primary: true;
                                                            clicked => {
                                                                keep-menu.show({ x: self.absolute-position.x - 120px, y: self.absolute-position.y + self.height });
                                                            }
                                                        }
                                                    }
                                                }
                                                keep-menu := ContextMenuArea {
                                                    enabled: false;
                                                    width: 0;
                                                    Menu {
                                                        MenuItem {
                                                            title: "Keep this computer's version";
                                                            activated => {
                                                                root.c-settle(i, 0);
                                                            }
                                                        }
                                                        MenuItem {
                                                            title: "Keep the OneDrive version";
                                                            activated => {
                                                                root.c-settle(i, 1);
                                                            }
                                                        }
                                                        MenuItem {
                                                            title: "Keep both";
                                                            activated => {
                                                                root.c-settle(i, 2);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.s-signed-in && root.b-rows.length > 0: Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 6px;
                                        Heading {
                                            text: "Back up this computer's folders";
                                        }
                                        Hint {
                                            text: "Keep your important folders in OneDrive, so they're backed up and on your other devices. They stay where your apps expect them.";
                                        }
                                        for b[i] in root.b-rows: Rectangle {
                                            height: 52px;
                                            border-radius: 10px;
                                            background: b-touch.has-hover ? Theme.hover : transparent;
                                            animate background { duration: Theme.quick; }
                                            b-touch := TouchArea { }
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 12px;
                                                Rectangle {
                                                    width: 34px;
                                                    height: 34px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 9px;
                                                    background: b.state == 1 ? Theme.ok.with-alpha(0.18) : Theme.track;
                                                    Image {
                                                        width: 18px;
                                                        height: 18px;
                                                        source: @image-url("../assets/ui/folder.svg");
                                                        colorize: b.state == 1 ? Theme.ok : Theme.subtle-text;
                                                    }
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 1px;
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        Text {
                                                            text: b.label;
                                                            font-weight: 600;
                                                        }
                                                        if b.state == 1: Badge {
                                                            text: "✓ Backed up";
                                                            tone: Theme.ok;
                                                        }
                                                        Rectangle {
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                    Text {
                                                        text: b.detail;
                                                        font-size: 12px;
                                                        color: Theme.subtle-text;
                                                        overflow: elide;
                                                    }
                                                }
                                                if b.state == 0: Button {
                                                    text: "Back up…";
                                                    enabled: !root.b-busy;
                                                    clicked => {
                                                        root.b-start(i);
                                                    }
                                                }
                                                if b.state == 1: Button {
                                                    text: "Stop…";
                                                    enabled: !root.b-busy;
                                                    clicked => {
                                                        root.b-stop(i);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    Button {
                                        text: "Remove account from this computer…";
                                        enabled: !root.s-busy;
                                        clicked => {
                                            root.remove-account();
                                        }
                                    }
                                    if root.s-busy: Spinner {
                                        indeterminate: true;
                                        width: 22px;
                                        height: 22px;
                                    }
                                }
                                if root.s-msg != "": Hint {
                                    text: root.s-msg;
                                }
                            }
                        }

                        if root.tab == 1: VerticalLayout {
                            padding: 2px;
                            padding-top: 4px;
                            padding-bottom: 14px;
                            spacing: 8px;
                            CheckBox {
                                text: "Sync everything";
                                checked <=> root.f-sync-all;
                                toggled => {
                                    root.f-sync-all-toggled();
                                }
                            }
                            Hint {
                                text: root.f-sync-all ? "Every folder in this account is kept on this computer. Untick to choose specific folders." : "Only the ticked folders (and everything inside them) are kept on this computer.";
                            }
                            if !root.f-sync-all: CheckBox {
                                text: "Also sync files that sit at the top level (outside any folder)";
                                checked <=> root.f-root-files;
                                toggled => {
                                    root.f-root-toggled();
                                }
                            }
                            if !root.f-sync-all: Card {
                                vertical-stretch: 1;
                                ListView {
                                    for row[i] in root.f-rows: HorizontalLayout {
                                        height: 30px;
                                        padding-left: 6px + row.depth * 22px;
                                        spacing: 4px;
                                        Rectangle {
                                            width: 22px;
                                            border-width: expand-focus.has-focus ? 2px : 0;
                                            border-color: Theme.accent;
                                            accessible-role: button;
                                            accessible-label: row.loading ? "Loading subfolders for " + row.name : (row.expanded ? "Collapse " : "Expand ") + row.name;
                                            accessible-enabled: row.has-children;
                                            accessible-action-default => {
                                                if (row.has-children) {
                                                    root.f-expand(i);
                                                }
                                            }
                                            Text {
                                                text: row.loading ? "…" : !row.has-children ? "" : row.expanded ? "▾" : "▸";
                                                font-size: 14px;
                                            }
                                            TouchArea {
                                                enabled: row.has-children;
                                                clicked => {
                                                    expand-focus.focus();
                                                    root.f-expand(i);
                                                }
                                            }
                                            expand-focus := FocusScope {
                                                x: 0;
                                                width: 0;
                                                enabled: row.has-children;
                                                key-pressed(event) => {
                                                    if (event.text == Key.Space || event.text == Key.Return) {
                                                        root.f-expand(i);
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                            }
                                        }
                                        CheckBox {
                                            text: row.name;
                                            checked: row.checked;
                                            enabled: !row.inherited;
                                            toggled => {
                                                root.f-check(i);
                                            }
                                        }
                                    }
                                }
                            }
                            if root.f-sync-all: Rectangle {
                                vertical-stretch: 1;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                if root.f-loading: Spinner {
                                    indeterminate: true;
                                    width: 22px;
                                    height: 22px;
                                }
                                Hint {
                                    text: root.f-msg;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "Reload";
                                    clicked => {
                                        root.f-reload();
                                    }
                                }
                                Button {
                                    text: "Apply changes…";
                                    primary: true;
                                    enabled: root.f-dirty && root.f-allowed;
                                    clicked => {
                                        root.f-apply();
                                    }
                                }
                            }
                        }

                        if root.tab == 2: ScrollView {
                            VerticalLayout {
                                padding: 2px;
                                padding-top: 4px;
                                padding-bottom: 14px;
                                spacing: 12px;
                                alignment: start;

                                Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;
                                        Heading {
                                            text: "When to sync";
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Full check every";
                                                vertical-alignment: center;
                                                width: 150px;
                                            }
                                            ComboBox {
                                                accessible-label: "How often to check for changes";
                                                model: ["5 minutes", "10 minutes", "15 minutes", "30 minutes", "1 hour", "2 hours"];
                                                current-index <=> root.o-interval;
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        Hint {
                                            text: "Changes on this computer are sent right away, and personal accounts also get online changes instantly. This sets how often a full check runs as well.";
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            CheckBox {
                                                text: "Only sync between";
                                                checked <=> root.o-sched-on;
                                            }
                                            LineEdit {
                                                accessible-label: "Schedule start time";
                                                text <=> root.o-from;
                                                enabled: root.o-sched-on;
                                                width: 80px;
                                                placeholder-text: "23:00";
                                            }
                                            Text {
                                                text: "and";
                                                vertical-alignment: center;
                                            }
                                            LineEdit {
                                                accessible-label: "Schedule end time";
                                                text <=> root.o-to;
                                                enabled: root.o-sched-on;
                                                width: 80px;
                                                placeholder-text: "07:00";
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        Hint {
                                            text: "Use 24-hour times. The window can cross midnight (for example 23:00 to 07:00 for overnight only). \"Sync now\" still works outside it for an hour. Needs the tray icon running.";
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Speed limit";
                                                vertical-alignment: center;
                                                width: 150px;
                                            }
                                            ComboBox {
                                                accessible-label: "Sync speed limit";
                                                model: ["No limit", "1 MB/s", "2 MB/s", "5 MB/s", "10 MB/s", "25 MB/s", "50 MB/s"];
                                                current-index <=> root.o-rate;
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        Hint {
                                            text: "Applies to each file being transferred.";
                                        }
                                        CheckBox {
                                            text: "Connect over IPv4 only";
                                            checked <=> root.o-ipv4;
                                        }
                                        Hint {
                                            text: "Can fix syncing that's slow to start or keeps timing out on some networks.";
                                        }
                                    }
                                }

                                Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;
                                        Heading {
                                            text: "Direction";
                                        }
                                        ComboBox {
                                            accessible-label: "Sync direction";
                                            model: ["Both ways (normal)", "Download only", "Upload only"];
                                            current-index <=> root.o-direction;
                                            // chosen by the user (not loaded): a backup should survive
                                            // tidying up this computer, so keep online copies by default
                                            selected => {
                                                if (self.current-index == 2) {
                                                    root.o-keep-online = true;
                                                }
                                            }
                                        }
                                        Hint {
                                            text: root.o-direction == 1 ? "Keeps this computer a copy of what's online. Changes you make here aren't sent to OneDrive." : root.o-direction == 2 ? "Sends what you change here to OneDrive, but doesn't download changes made online. Good for backing up this computer." : "Changes made here go to OneDrive, and changes made online come here.";
                                        }
                                        if root.o-direction == 1: CheckBox {
                                            text: "Also delete files here that aren't online";
                                            checked <=> root.o-cleanup;
                                        }
                                        if root.o-direction == 1 && root.o-cleanup: Text {
                                            text: "This deletes files you put in this folder yourself, since they aren't online. You'll see exactly what would be deleted before anything happens.";
                                            color: Theme.problem;
                                            wrap: word-wrap;
                                            font-size: 12px;
                                        }
                                        if root.o-direction == 2: CheckBox {
                                            text: "Keep files online when I delete them here";
                                            checked <=> root.o-keep-online;
                                        }
                                        Hint {
                                            text: "Changing the direction is checked first with a dry run, so you can see what would happen.";
                                        }
                                    }
                                }

                                Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;
                                        Heading {
                                            text: "Files";
                                        }
                                        CheckBox {
                                            text: "When a file is deleted online, move it to this computer's Trash instead of deleting it";
                                            checked <=> root.o-recycle;
                                        }
                                        CheckBox {
                                            text: "Show desktop notifications for synced files";
                                            checked <=> root.o-notify;
                                        }
                                        CheckBox {
                                            text: "Don't sync hidden files and folders (names starting with a dot) *";
                                            checked <=> root.o-skip-hidden;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Never sync files named *";
                                                vertical-alignment: center;
                                            }
                                            LineEdit {
                                                accessible-label: "File name patterns to skip";
                                                text <=> root.o-skip-files;
                                                placeholder-text: "~*|.~*|*.tmp|*.swp|*.partial";
                                            }
                                        }
                                        Hint {
                                            text: "Separate patterns with | — for example  *.tmp|~*|Thumbs.db";
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Never sync folders named *";
                                                vertical-alignment: center;
                                            }
                                            LineEdit {
                                                accessible-label: "Folder names or paths to skip";
                                                text <=> root.o-skip-dirs;
                                                placeholder-text: "node_modules|Temp|Cache";
                                            }
                                        }
                                        Hint {
                                            text: "A name skips every folder called that; a path like Projects/Old skips that folder.";
                                        }
                                        CheckBox {
                                            text: "Don't sync symbolic links *";
                                            checked <=> root.o-skip-symlinks;
                                        }
                                        CheckBox {
                                            text: "Skip any folder that holds a file named .nosync *";
                                            checked <=> root.o-nosync;
                                        }
                                        if root.o-is-business: CheckBox {
                                            text: "Sync shared folders I've added to My files *";
                                            checked <=> root.o-shared;
                                        }
                                    }
                                }

                                Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;
                                        Heading {
                                            text: "Safety";
                                        }
                                        CheckBox {
                                            text: "Allow full resyncs for this account";
                                            checked <=> root.o-allow-resync;
                                        }
                                        Hint {
                                            text: "Changing which folders sync, or the settings marked *, makes the sync engine rebuild its view of everything (a full resync). You always get a preview of what would be downloaded, uploaded or deleted before anything happens. Turn this off to lock those settings.";
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Stop and ask when more than";
                                                vertical-alignment: center;
                                            }
                                            LineEdit {
                                                accessible-label: "Number of deleted items that stops syncing";
                                                text <=> root.o-big-delete;
                                                width: 90px;
                                                placeholder-text: "1000";
                                                input-type: number;
                                            }
                                            Text {
                                                text: "items are deleted at once";
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        Hint {
                                            text: "Protects against deleting a lot online by accident, for example when a folder is moved out of OneDrive or a drive goes missing. Items inside deleted folders count too. The client's default is 1000.";
                                        }
                                    }
                                }

                                Card {
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;
                                                Heading {
                                                    text: "Advanced";
                                                }
                                                Hint {
                                                    text: "Fine-tune the sync engine. Most people never need these.";
                                                }
                                            }
                                            Switch {
                                                text: root.o-adv-open ? "Shown" : "Hidden";
                                                accessible-label: "Show advanced settings";
                                                checked <=> root.o-adv-open;
                                            }
                                        }
                                        if root.o-adv-open: VerticalLayout {
                                            spacing: 10px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                LineEdit {
                                                    accessible-label: "Search advanced settings";
                                                    placeholder-text: "Search settings (threads, timeout, log…)";
                                                    text <=> root.o-adv-query;
                                                    edited(t) => {
                                                        root.o-adv-search(t);
                                                    }
                                                }
                                            }
                                            if root.o-adv-query == "": Segmented {
                                                labels: root.o-adv-groups;
                                                current <=> root.o-adv-tab;
                                            }
                                            VerticalLayout {
                                                spacing: 0px;
                                                for row[i] in root.o-adv: VerticalLayout {
                                                    property <bool> shown: root.o-adv-query == "" ? row.group == root.o-adv-groups[root.o-adv-tab] : row.matched;
                                                    // turned on only through another setting that's off
                                                    property <bool> active: row.needs == -1 || (row.needs == -2 ? root.o-recycle : root.o-adv[row.needs].checked);
                                                    property <bool> changed: row.kind == 0 ? row.checked != row.default-checked : row.kind == 3 ? row.choice != row.default-choice : row.text != row.default-text;
                                                    if shown: Rectangle {
                                                        border-radius: 10px;
                                                        background: tile-touch.has-hover ? Theme.hover : transparent;
                                                        animate background { duration: Theme.quick; }
                                                        tile-touch := TouchArea { }
                                                        HorizontalLayout {
                                                            padding: 10px;
                                                            padding-left: row.needs == -1 ? 10px : 26px;
                                                            spacing: 12px;
                                                            // a slim bar ties a dependent setting to the one above it
                                                            if row.needs != -1: Rectangle {
                                                                width: 2px;
                                                                border-radius: 1px;
                                                                background: active ? Theme.accent : Theme.track;
                                                            }
                                                            VerticalLayout {
                                                                horizontal-stretch: 1;
                                                                spacing: 3px;
                                                                alignment: center;
                                                                HorizontalLayout {
                                                                    spacing: 6px;
                                                                    Rectangle {
                                                                        width: 7px;
                                                                        height: 7px;
                                                                        y: (parent.height - self.height) / 2;
                                                                        border-radius: 3.5px;
                                                                        background: Theme.accent;
                                                                        visible: changed;
                                                                    }
                                                                    Text {
                                                                        text: row.label;
                                                                        font-weight: 600;
                                                                        wrap: word-wrap;
                                                                        horizontal-stretch: 1;
                                                                        opacity: active ? 1 : 0.5;
                                                                    }
                                                                }
                                                                if row.hint != "": Hint {
                                                                    text: row.hint;
                                                                    opacity: active ? 1 : 0.5;
                                                                }
                                                                HorizontalLayout {
                                                                    spacing: 6px;
                                                                    alignment: start;
                                                                    if root.o-adv-query != "": Badge {
                                                                        text: row.group;
                                                                        tone: Theme.off;
                                                                    }
                                                                    if row.risky: Badge {
                                                                        text: "⚠ Can lose data";
                                                                        tone: Theme.warn;
                                                                    }
                                                                    if row.effect == 1: Badge {
                                                                        text: "Full resync";
                                                                        tone: Theme.accent;
                                                                    }
                                                                    if row.effect == 2: Badge {
                                                                        text: "Sign in again";
                                                                        tone: Theme.accent;
                                                                    }
                                                                    if changed: Rectangle {
                                                                        width: reset-text.preferred-width + 12px;
                                                                        height: 20px;
                                                                        border-radius: 10px;
                                                                        background: reset-touch.has-hover ? Theme.hover : transparent;
                                                                        accessible-role: button;
                                                                        accessible-label: "Reset " + row.label + " to the default";
                                                                        accessible-action-default => {
                                                                            reset-touch.clicked();
                                                                        }
                                                                        reset-text := Text {
                                                                            text: "↺ Reset to default";
                                                                            font-size: 11px;
                                                                            color: Theme.accent;
                                                                            vertical-alignment: center;
                                                                        }
                                                                        reset-touch := TouchArea {
                                                                            mouse-cursor: pointer;
                                                                            clicked => {
                                                                                row.checked = row.default-checked;
                                                                                row.text = row.default-text;
                                                                                row.choice = row.default-choice;
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                                if row.error != "": Text {
                                                                    text: row.error;
                                                                    color: Theme.problem;
                                                                    wrap: word-wrap;
                                                                    font-size: 12px;
                                                                }
                                                            }
                                                            if row.kind == 0: Switch {
                                                                checked <=> row.checked;
                                                                enabled: active;
                                                                accessible-label: row.label;
                                                            }
                                                            if row.kind == 1 || row.kind == 2: HorizontalLayout {
                                                                spacing: 6px;
                                                                alignment: end;
                                                                LineEdit {
                                                                    accessible-label: row.label;
                                                                    text <=> row.text;
                                                                    enabled: active;
                                                                    placeholder-text: row.placeholder;
                                                                    width: row.kind == 1 ? 96px : 260px;
                                                                    input-type: row.kind == 1 ? InputType.number : InputType.text;
                                                                    horizontal-alignment: row.kind == 1 ? right : left;
                                                                }
                                                                if row.unit != "": Text {
                                                                    text: row.unit;
                                                                    color: Theme.subtle-text;
                                                                    vertical-alignment: center;
                                                                    min-width: 52px;
                                                                }
                                                            }
                                                            if row.kind == 3: ComboBox {
                                                                accessible-label: row.label;
                                                                model: row.choices;
                                                                current-index <=> row.choice;
                                                                enabled: active;
                                                                width: 220px;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if root.o-adv-query != "" && !root.o-adv-any-match: Hint {
                                                text: "No setting matches \"" + root.o-adv-query + "\".";
                                                horizontal-alignment: center;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Show all settings in use";
                                                clicked => {
                                                    root.o-show-config();
                                                }
                                            }
                                            Button {
                                                text: "Open log folder";
                                                clicked => {
                                                    root.o-open-logs();
                                                }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Hint {
                                        text: root.o-msg;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Button {
                                        text: "Save";
                                        primary: true;
                                        clicked => {
                                            root.o-save();
                                        }
                                    }
                                }
                            }
                        }

                        if root.tab == 3: VerticalLayout {
                            padding: 2px;
                            padding-top: 4px;
                            padding-bottom: 14px;
                            spacing: 8px;
                            StandardTableView {
                                vertical-stretch: 1;
                                columns: [{ title: "When", width: 120px }, { title: "What", width: 110px }, { title: "File", horizontal-stretch: 1 }];
                                rows: root.a-rows;
                                current-row <=> root.a-current;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Hint {
                                    text: "Recent uploads, downloads and deletions from the sync log.";
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "Show in folder";
                                    enabled: root.a-current >= 0;
                                    clicked => {
                                        root.a-show(root.a-current);
                                    }
                                }
                                Button {
                                    text: "Refresh";
                                    clicked => {
                                        root.a-refresh();
                                    }
                                }
                            }
                        }
                }
            }

            // ---- add account
            if root.current == -1: ScrollView {
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    alignment: start;
                    Title {
                        text: root.accounts.length == 0 ? "Welcome — let's add your OneDrive" : "Add an account";
                    }
                    if root.add-mode == 0: VerticalLayout {
                        spacing: 12px;
                        Hint {
                            text: "What would you like to sync?";
                            font-size: 14px;
                        }
                        ChoiceCard {
                            title: "OneDrive";
                            detail: "A personal Microsoft account (Outlook, Hotmail, Live) or a work or school account.";
                            height: 86px;
                            clicked => {
                                root.add-choose(1);
                            }
                        }
                        ChoiceCard {
                            title: "SharePoint library";
                            detail: "A document library from a SharePoint or Teams site. You'll need a work or school account added first.";
                            height: 86px;
                            clicked => {
                                root.add-choose(2);
                            }
                        }
                    }
                    if root.add-mode == 1 || root.add-mode == 2: VerticalLayout {
                        spacing: 10px;
                        if root.add-mode == 2: Card {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Heading {
                                    text: "1. Find the library";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Using account";
                                        width: 120px;
                                        vertical-alignment: center;
                                    }
                                    ComboBox {
                                        accessible-label: "Work or school account for this library";
                                        model: root.add-from;
                                        current-index <=> root.add-from-index;
                                        horizontal-stretch: 1;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Site";
                                        width: 120px;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        accessible-label: "SharePoint site address or name";
                                        text <=> root.add-query;
                                        placeholder-text: "Paste the site's address, or type part of its name";
                                        accepted => {
                                            root.add-search();
                                        }
                                    }
                                    Button {
                                        text: "Find";
                                        enabled: !root.add-busy;
                                        clicked => {
                                            root.add-search();
                                        }
                                    }
                                }
                                Hint {
                                    text: "Copy the address from your browser while viewing the SharePoint site or library. Leave it empty to list the sites you belong to — only sites this account can already open appear.";
                                }
                                if root.add-libraries.length > 0: Rectangle {
                                    height: min(root.add-libraries.length * 30px + 8px, 220px);
                                    border-width: 1px;
                                    border-color: Palette.border;
                                    border-radius: 6px;
                                    ListView {
                                        for lib[i] in root.add-libraries: Rectangle {
                                            height: 30px;
                                            background: root.add-lib-index == i ? Palette.selection-background.with-alpha(0.35) : lta.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                                            border-width: lib-focus.has-focus ? 2px : 0;
                                            border-color: Theme.accent;
                                            accessible-role: list-item;
                                            accessible-label: lib;
                                            accessible-item-index: i;
                                            accessible-action-default => {
                                                root.add-lib-picked(i);
                                            }
                                            lta := TouchArea {
                                                clicked => {
                                                    lib-focus.focus();
                                                    root.add-lib-picked(i);
                                                }
                                            }
                                            lib-focus := FocusScope {
                                                x: 0;
                                                width: 0;
                                                key-pressed(event) => {
                                                    if (event.text == Key.Space || event.text == Key.Return) {
                                                        root.add-lib-picked(i);
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                            }
                                            Text {
                                                x: 10px;
                                                text: lib;
                                                vertical-alignment: center;
                                                height: parent.height;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Card {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Heading {
                                    text: root.add-mode == 2 ? "2. Where to keep it" : "Name and folder";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Name";
                                        width: 120px;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        accessible-label: "Account name";
                                        text <=> root.add-name;
                                        placeholder-text: "e.g. Personal, Work";
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Local folder";
                                        width: 120px;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        accessible-label: "Local folder for synced files";
                                        text <=> root.add-folder;
                                    }
                                    Button {
                                        text: "Browse…";
                                        clicked => {
                                            root.add-browse();
                                        }
                                    }
                                }
                                Hint {
                                    text: "Best to pick an empty or new folder. Anything already in it will be uploaded.";
                                }
                                if root.add-mode == 1: HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Microsoft cloud";
                                        width: 120px;
                                        vertical-alignment: center;
                                    }
                                    ComboBox {
                                        accessible-label: "Microsoft cloud";
                                        model: ["Worldwide (normal)", "US Government (GCC High)", "US Government (DoD)", "Germany", "China (21Vianet)"];
                                        current-index <=> root.add-cloud;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }
                                if root.add-mode == 1 && root.add-cloud > 0: HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Tenant";
                                        width: 120px;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        accessible-label: "Organization tenant";
                                        text <=> root.add-tenant;
                                        placeholder-text: "contoso.onmicrosoft.us";
                                    }
                                }
                                if root.add-mode == 1 && root.add-cloud > 0: Hint {
                                    text: "Only for government and national cloud accounts. Your IT team can tell you the tenant.";
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button {
                                text: "Back";
                                clicked => {
                                    root.add-choose(0);
                                }
                            }
                            Button {
                                text: root.add-mode == 2 ? "Add library" : "Continue and sign in…";
                                primary: true;
                                enabled: !root.add-busy;
                                clicked => {
                                    root.add-create();
                                }
                            }
                            if root.add-busy: Spinner {
                                indeterminate: true;
                                width: 22px;
                                height: 22px;
                            }
                        }
                    }
                    if root.add-msg != "": Text {
                        text: root.add-msg;
                        wrap: word-wrap;
                    }
                }
            }

            // ---- app settings
            if root.current == -2: ScrollView {
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    alignment: start;
                    Title {
                        text: "App settings";
                    }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            CheckBox {
                                text: "Show the tray icon when I log in";
                                checked <=> root.app-autostart;
                                toggled => {
                                    root.app-autostart-toggled();
                                }
                            }
                            Hint {
                                text: "Syncing itself keeps running in the background either way. The tray icon shows status and runs sync schedules.";
                            }
                            CheckBox {
                                text: "Stop syncing when I quit the tray icon";
                                checked <=> root.app-stop-on-quit;
                                toggled => {
                                    root.app-stop-on-quit-toggled();
                                }
                            }
                            Hint {
                                text: "\"Quit\" in the tray icon's menu then stops syncing too. It starts again the next time the app opens or you log in.";
                            }
                            CheckBox {
                                text: "Pause syncing on a metered network";
                                checked <=> root.app-pause-metered;
                                toggled => {
                                    root.app-pause-toggled();
                                }
                            }
                            Hint {
                                text: "Saves your data allowance on a phone hotspot or a connection you've marked as metered in your network settings.";
                            }
                            CheckBox {
                                text: "Pause syncing while power saver is on";
                                checked <=> root.app-pause-saver;
                                toggled => {
                                    root.app-pause-toggled();
                                }
                            }
                            Hint {
                                text: "Syncing carries on by itself afterwards. \"Sync now\" still syncs for an hour if you need it to.";
                            }
                            CheckBox {
                                text: "Show sync badges on files in Dolphin, Nemo and Caja";
                                checked <=> root.app-badges;
                                toggled => {
                                    root.app-badges-toggled();
                                }
                            }
                            Hint {
                                text: "A small tick, arrows or warning sign on the files in your OneDrive folders. File manager windows that are already open show them once they're reopened.";
                            }
                            if root.app-badges && root.app-dolphin-offer: HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: root.app-dolphin-busy ? "Adding…" : "Add badges to Dolphin…";
                                    enabled: !root.app-dolphin-busy;
                                    clicked => {
                                        root.app-dolphin-install();
                                    }
                                }
                            }
                            if root.app-badges && root.app-dolphin-offer: Hint {
                                text: "Dolphin needs a small plugin installed for everyone on this computer, so it asks for your password once.";
                            }
                            if root.app-badges-msg != "": Hint {
                                text: root.app-badges-msg;
                            }
                            CheckBox {
                                text: "Tell me when a new version is out";
                                checked <=> root.app-check-updates;
                                toggled => {
                                    root.app-check-updates-toggled();
                                }
                            }
                            Hint {
                                text: "Looks at this app's page on GitHub once a day. Nothing is downloaded or installed by itself.";
                            }
                            if root.app-update != "": HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "Version " + root.app-update + " is out.";
                                    vertical-alignment: center;
                                    font-weight: 600;
                                }
                                Button {
                                    text: "Get it";
                                    primary: true;
                                    clicked => {
                                        root.app-get-update();
                                    }
                                }
                            }
                            if root.app-is-appimage: HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Button {
                                    text: "Add to my applications menu";
                                    clicked => {
                                        root.app-add-to-menu();
                                    }
                                }
                            }
                            if root.app-msg != "": Hint {
                                text: root.app-msg;
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Heading {
                                text: "Appearance";
                            }
                            Hint {
                                text: "Colours, light or dark mode, text size and animations follow your desktop's settings.";
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Glass effect";
                                    vertical-alignment: center;
                                    width: 150px;
                                }
                                ComboBox {
                                    accessible-label: "Glass effect";
                                    model: ["Automatic", "On", "Off"];
                                    current-index <=> root.app-glass;
                                    selected => {
                                        root.app-glass-changed();
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            Hint {
                                text: root.app-glass-note;
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            Heading {
                                text: "About";
                            }
                            Text {
                                text: "DriveDeck for OneDrive " + root.app-version;
                                font-weight: 600;
                            }
                            Text {
                                text: "The easiest, most complete way to use OneDrive on Linux.";
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.app-client;
                                wrap: word-wrap;
                            }
                            Hint {
                                text: "Free software under the GNU GPL v3. Syncing is done by the OneDrive Client for Linux by abraunegg (GPL v3). Not made by or affiliated with Microsoft. OneDrive is a trademark of Microsoft.";
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Button {
                                    text: "Project page";
                                    clicked => {
                                        root.open-url("https://github.com/sweatshopking/DriveDeck");
                                    }
                                }
                                Button {
                                    text: "Sync engine (abraunegg/onedrive)";
                                    clicked => {
                                        root.open-url("https://github.com/abraunegg/onedrive");
                                    }
                                }
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            Heading {
                                text: "Uninstall";
                            }
                            Hint {
                                text: "Remove this app, and choose whether to keep your OneDrive setup for the command-line client or remove that too. Your synced files always stay on this computer.";
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Uninstall…";
                                    clicked => {
                                        root.app-uninstall();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
        }
    }

    // ======== dialogs
    if root.si-visible: Overlay {
        width: root.width;
        height: root.height;
        Card {
            width: min(560px, root.width - 40px);
            height: si-layout.preferred-height;
            background: Theme.dialog;
            border-radius: 14px;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            si-layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading {
                    text: "Sign in to Microsoft";
                    font-size: 16px;
                }
                Text {
                    text: root.si-text;
                    wrap: word-wrap;
                }
                if root.si-need-paste: LineEdit {
                    accessible-label: "Address from the blank sign-in page";
                    text <=> root.si-paste;
                    placeholder-text: "https://login.microsoftonline.com/common/oauth2/nativeclient?code=…";
                    accepted => {
                        root.si-submit();
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if root.si-has-url && !root.si-done: Button {
                        text: "Copy link";
                        clicked => {
                            root.si-copy-url();
                        }
                    }
                    if root.si-has-url && !root.si-done: Button {
                        text: "Open sign-in page again";
                        clicked => {
                            root.si-open-url();
                        }
                    }
                    if root.si-need-paste: Button {
                        text: "Finish sign-in";
                        primary: true;
                        clicked => {
                            root.si-submit();
                        }
                    }
                    Button {
                        text: root.si-done ? "Close" : "Cancel";
                        primary: root.si-done;
                        clicked => {
                            root.si-close();
                        }
                    }
                }
            }
        }
    }

    if root.p-visible: Overlay {
        width: root.width;
        height: root.height;
        Card {
            width: min(640px, root.width - 40px);
            height: p-layout.preferred-height;
            background: Theme.dialog;
            border-radius: 14px;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            p-layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading {
                    text: root.p-title;
                    font-size: 16px;
                }
                if root.p-busy: HorizontalLayout {
                    spacing: 10px;
                    Spinner {
                        indeterminate: true;
                        width: 22px;
                        height: 22px;
                    }
                    Text {
                        text: root.p-live;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.p-text;
                    wrap: word-wrap;
                }
                if root.p-warn != "": Text {
                    text: root.p-warn;
                    wrap: word-wrap;
                    color: Theme.problem;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.p-cancel();
                        }
                    }
                    Button {
                        text: "Apply";
                        primary: true;
                        enabled: root.p-can-apply && !root.p-busy;
                        clicked => {
                            root.p-apply();
                        }
                    }
                }
            }
        }
    }

    if root.u-visible: Overlay {
        width: root.width;
        height: root.height;
        Card {
            width: min(600px, root.width - 40px);
            height: u-layout.preferred-height;
            background: Theme.dialog;
            border-radius: 14px;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            u-layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading {
                    text: "Uninstall";
                    font-size: 16px;
                }
                if root.u-result == "": VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "What should happen to your OneDrive setup (sign-ins, chosen folders and options)? Your synced files stay on this computer either way.";
                        wrap: word-wrap;
                    }
                    UninstallChoice {
                        title: "Keep my OneDrive setup";
                        detail: "Only this app is removed. Your accounts keep syncing in the background with the OneDrive Client for Linux, which you can keep using from the command line.";
                        selected: root.u-keep-setup;
                        enabled: !root.u-busy;
                        clicked => {
                            root.u-keep-setup = true;
                        }
                    }
                    UninstallChoice {
                        title: "Remove everything";
                        detail: "Also stop all background syncing, sign out, and delete every OneDrive sync configuration on this computer, including ones made with the command-line client.";
                        selected: !root.u-keep-setup;
                        enabled: !root.u-busy;
                        clicked => {
                            root.u-keep-setup = false;
                        }
                    }
                    Hint {
                        text: root.u-remove-app-label;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        if root.u-busy: Spinner {
                            indeterminate: true;
                            width: 22px;
                            height: 22px;
                        }
                        Button {
                            text: "Cancel";
                            enabled: !root.u-busy;
                            clicked => {
                                root.u-cancel();
                            }
                        }
                        Button {
                            text: "Uninstall";
                            primary: true;
                            enabled: !root.u-busy;
                            clicked => {
                                root.u-confirm();
                            }
                        }
                    }
                }
                if root.u-result != "": VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: root.u-result;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: "Close";
                            primary: true;
                            clicked => {
                                root.u-cancel();
                            }
                        }
                    }
                }
            }
        }
    }

    if root.mv-visible: Overlay {
        width: root.width;
        height: root.height;
        Card {
            width: min(600px, root.width - 40px);
            height: mv-layout.preferred-height;
            background: Theme.dialog;
            border-radius: 14px;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            mv-layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading {
                    text: "Move your OneDrive folder";
                    font-size: 16px;
                }
                Text {
                    text: "This moves the folder that holds this account's files, now " + root.mv-from + ", to a new place — for example another hard drive with more space. Your files stay in OneDrive the whole time, and nothing is downloaded again.";
                    wrap: word-wrap;
                }
                Text {
                    text: "What happens after you choose the new place:";
                    wrap: word-wrap;
                    font-weight: 600;
                }
                Text {
                    text: "1. Syncing for this account pauses.\n2. The files go to the new place. On the same drive they're simply moved, which is instant. To another drive they're copied, which can take a while for a big folder.\n3. A check runs to confirm everything matches online (a dry run, nothing changes). Press Apply and syncing carries on from the new place.";
                    wrap: word-wrap;
                }
                Text {
                    text: "Moving to another drive leaves your old folder exactly as it was: nothing is ever deleted for you, so no files can be lost if the copy goes wrong. Once you've checked your files are in the new place, delete the old folder yourself to free up the space. Until then, it isn't synced any more and changes made in it won't reach OneDrive.";
                    wrap: word-wrap;
                    color: Theme.warn;
                }
                Hint {
                    text: "Pick an empty folder to use it as the new OneDrive folder. Pick a folder that already has things in it (like the top of a drive) and a folder named like the current one is made inside it. Make sure the new drive has enough free space and is always connected (mounted automatically).";
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.mv-visible = false;
                        }
                    }
                    Button {
                        text: "Choose new location…";
                        primary: true;
                        clicked => {
                            root.mv-visible = false;
                            root.move-folder();
                        }
                    }
                }
            }
        }
    }

    if root.bk-visible: Overlay {
        width: root.width;
        height: root.height;
        Card {
            width: min(580px, root.width - 40px);
            height: bk-layout.preferred-height;
            background: Theme.dialog;
            border-radius: 14px;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            bk-layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading {
                    text: root.bk-title;
                    font-size: 16px;
                }
                Text {
                    text: root.bk-text;
                    wrap: word-wrap;
                }
                if root.bk-warn != "": Text {
                    text: root.bk-warn;
                    wrap: word-wrap;
                    color: Theme.warn;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if root.b-busy: Spinner {
                        indeterminate: true;
                        width: 22px;
                        height: 22px;
                    }
                    Button {
                        text: "Cancel";
                        enabled: !root.b-busy;
                        clicked => {
                            root.bk-visible = false;
                        }
                    }
                    Button {
                        text: root.bk-action;
                        primary: true;
                        enabled: !root.b-busy;
                        clicked => {
                            root.bk-confirm();
                        }
                    }
                }
            }
        }
    }

    if root.cfg-visible: Overlay {
        width: root.width;
        height: root.height;
        Card {
            width: min(720px, root.width - 40px);
            height: min(560px, root.height - 40px);
            background: Theme.dialog;
            border-radius: 14px;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading {
                    text: "All settings in use";
                    font-size: 16px;
                }
                Hint {
                    text: "What the sync engine reads from this account's config file, including the defaults for anything not set.";
                }
                if root.cfg-busy: Spinner {
                    indeterminate: true;
                    width: 22px;
                    height: 22px;
                }
                ScrollView {
                    vertical-stretch: 1;
                    Text {
                        text: root.cfg-text;
                        font-family: "monospace";
                        font-size: 12px;
                        wrap: no-wrap;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Close";
                        primary: true;
                        clicked => {
                            root.cfg-visible = false;
                        }
                    }
                }
            }
        }
    }

    if root.r-visible: Overlay {
        width: root.width;
        height: root.height;
        Card {
            width: min(560px, root.width - 40px);
            height: r-layout.preferred-height;
            background: Theme.dialog;
            border-radius: 14px;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            r-layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading {
                    text: "Remove account";
                    font-size: 16px;
                }
                Text {
                    text: root.r-text;
                    wrap: word-wrap;
                }
                CheckBox {
                    text: "Also sign out and delete this account's sync settings";
                    checked <=> root.r-delete-config;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.r-cancel();
                        }
                    }
                    Button {
                        text: "Remove";
                        primary: true;
                        clicked => {
                            root.r-confirm();
                        }
                    }
                }
            }
        }
    }

    if root.ci-visible: Overlay {
        width: root.width;
        height: root.height;
        Card {
            width: min(560px, root.width - 40px);
            height: ci-layout.preferred-height;
            background: Theme.dialog;
            border-radius: 14px;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            ci-layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading {
                    text: root.ci-title;
                    font-size: 16px;
                }
                Text {
                    text: root.ci-text;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    // installing by hand instead; the window notices the client by itself
                    if !root.client-update: Button {
                        text: "I'll install it myself";
                        clicked => {
                            root.ci-myself();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.ci-cancel();
                        }
                    }
                    Button {
                        text: root.ci-action;
                        primary: true;
                        clicked => {
                            root.ci-confirm();
                        }
                    }
                }
            }
        }
    }
}

// ================================================================ tray popup
// What a click on the tray icon opens: each account's status, files syncing now and recent
// files, each list with its own scroll bar and keyboard use (arrows, Home/End, Enter).

export struct PanelAccount {
    name: string,
    status: string,
    tone: int, // as in AccountRow
    personal: bool, // has "Restore your OneDrive"
}

export struct PanelFile {
    name: string,
    // folder, what happened and when (or how far a transfer has got), and the account
    detail: string,
    kind: int, // core::file_kind
    percent: int, // a transfer's progress; -1 for finished items
    can-open: bool, // still there to open (not deleted)
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label; // for screen readers
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: ta.pressed ? Theme.selected : ta.has-hover && enabled ? Theme.hover : transparent;
    opacity: enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.clicked();
        }
    }
    fs := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.accent;
    }
    Image {
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: Palette.foreground.with-alpha(0.8);
    }
}

// Arrow keys, Home/End and Enter for a list whose rows are all `row-height` tall; keeps the
// current row in view.
component ListKeys inherits FocusScope {
    in property <int> count;
    in property <length> row-height;
    in property <length> visible-height;
    in-out property <int> current: -1;
    in-out property <length> content-y;
    callback activated(int);
    x: 0;
    width: 0;
    function go(i: int) {
        if (root.count == 0) {
            return;
        }
        root.current = max(0, min(root.count - 1, i));
        if (root.current * root.row-height < -root.content-y) {
            root.content-y = -root.current * root.row-height;
        } else if ((root.current + 1) * root.row-height > -root.content-y + root.visible-height) {
            root.content-y = -((root.current + 1) * root.row-height - root.visible-height);
        }
    }
    key-pressed(event) => {
        if (event.text == Key.DownArrow) {
            go(root.current + 1);
            return accept;
        }
        if (event.text == Key.UpArrow) {
            go(root.current - 1);
            return accept;
        }
        if (event.text == Key.Home) {
            go(0);
            return accept;
        }
        if (event.text == Key.End) {
            go(root.count - 1);
            return accept;
        }
        if (event.text == Key.Return || event.text == Key.Space) {
            if (root.current >= 0 && root.current < root.count) {
                root.activated(root.current);
            }
            return accept;
        }
        return reject;
    }
    focus-changed-event => {
        if (self.has-focus && root.current < 0 && root.count > 0) {
            go(0);
        }
    }
}

component SectionTitle inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.subtle-text;
}

component FileList inherits Rectangle {
    in property <[PanelFile]> rows;
    in property <string> empty-text;
    in-out property <int> current: -1;
    property <length> row-h: 50px;
    callback open(int);
    callback reveal(int);
    forward-focus: keys;
    border-radius: 10px;
    background: Theme.card;
    border-width: keys.has-focus ? 2px : 1px;
    border-color: keys.has-focus ? Theme.accent : Theme.card-border;
    accessible-role: list;
    if root.rows.length == 0: Hint {
        x: 12px;
        width: parent.width - 24px;
        text: root.empty-text;
        vertical-alignment: center;
    }
    lv := ListView {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        for row[i] in root.rows: Rectangle {
            height: root.row-h;
            background: i == root.current && keys.has-focus ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
            accessible-role: list-item;
            accessible-label: row.name + ", " + row.detail;
            accessible-item-index: i;
            accessible-action-default => {
                root.open(i);
            }
            ta := TouchArea {
                mouse-cursor: row.can-open ? pointer : default;
                clicked => {
                    root.current = i;
                    keys.focus();
                    root.open(i);
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 10px;
                Image {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    source: [
                        @image-url("../assets/ui/file-other.svg"),
                        @image-url("../assets/ui/file-folder.svg"),
                        @image-url("../assets/ui/file-document.svg"),
                        @image-url("../assets/ui/file-spreadsheet.svg"),
                        @image-url("../assets/ui/file-presentation.svg"),
                        @image-url("../assets/ui/file-pdf.svg"),
                        @image-url("../assets/ui/file-picture.svg"),
                        @image-url("../assets/ui/file-video.svg"),
                        @image-url("../assets/ui/file-audio.svg"),
                        @image-url("../assets/ui/file-archive.svg"),
                        @image-url("../assets/ui/file-code.svg"),
                        @image-url("../assets/ui/file-text.svg"),
                    ][max(0, min(11, row.kind))];
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: row.name;
                        overflow: elide;
                        font-size: 13px;
                        font-weight: 500;
                    }
                    Text {
                        text: row.detail;
                        overflow: elide;
                        font-size: 11px;
                        color: Theme.subtle-text;
                    }
                    if row.percent >= 0: Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.track;
                        Rectangle {
                            x: 0;
                            width: parent.width * max(0, min(100, row.percent)) / 100;
                            border-radius: 2px;
                            background: Theme.accent;
                            animate width { duration: Theme.slide; }
                        }
                    }
                }
                // "show in folder", on the row under the mouse or picked with the keyboard
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("../assets/ui/reveal.svg");
                    label: "Show " + row.name + " in its folder";
                    opacity: ta.has-hover || (i == root.current && keys.has-focus) ? 1 : 0;
                    clicked => {
                        root.reveal(i);
                    }
                }
            }
        }
    }
    keys := ListKeys {
        count: root.rows.length;
        row-height: root.row-h;
        visible-height: lv.visible-height;
        current <=> root.current;
        content-y <=> lv.content-y;
        activated(i) => {
            root.open(i);
        }
    }
}

export component PopupPanel inherits Window {
    title: "OneDrive";
    icon: @image-url("../assets/drivedeck.svg");
    no-frame: true;
    width: 380px;
    height: 600px;
    // rounded corners only where the window can be see-through (a compositor; always on Wayland)
    in property <bool> rounded;
    background: rounded ? transparent : Theme.dialog;
    in property <bool> dark;
    // the app's own colours (Theme) follow along with the standard widgets' (Palette)
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
        Theme.dark = self.dark;
    }
    init => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
        Theme.dark = self.dark;
    }

    in property <string> summary;
    in property <int> summary-tone;
    in property <[PanelAccount]> accounts;
    in property <[PanelFile]> transfers;
    in property <[PanelFile]> recent;
    // files that didn't sync, and why
    in property <[PanelFile]> blocked;
    in-out property <int> bl-current: -1;
    callback reveal-blocked(int);
    // the account picker above the recent files: 0 all, then each account
    in property <[string]> filters;
    in-out property <int> filter;
    in property <bool> any-paused;
    // a newer version that's out, or ""
    in property <string> update;
    callback get-update();
    // some account can sync now (signed in, no resync running, the client installed)
    in property <bool> can-sync;
    in-out property <int> acc-current: -1;
    in-out property <int> tr-current: -1;
    in-out property <int> rec-current: -1;

    callback close-panel();
    callback sync-now();
    callback settings(int); // -1: no particular account
    callback pause(int); // seconds; -1 until tomorrow, 0 resume
    callback open-file(bool, int); // transfer list?, row
    callback reveal-file(bool, int);
    callback open-folder(int); // account index
    callback view-online(int, int); // account, page: 0 website, 1 recycle bin, 2 restore
    callback filter-changed();

    property <length> acc-row-h: 38px;

    forward-focus: rec;

    Rectangle {
        border-radius: root.rounded ? 14px : 0;
        background: Theme.dialog;
        border-width: 1px;
        border-color: Theme.card-border;
        clip: true;

        // Esc closes; arrow keys etc. go to the focused list first
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-panel();
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // ---- header
                HorizontalLayout {
                    spacing: 10px;
                    Image {
                        width: 30px;
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../assets/drivedeck.svg");
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "OneDrive";
                            font-size: 15px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            ToneDot {
                                tone: root.summary-tone;
                                width: 8px;
                                height: 8px;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: root.summary;
                                font-size: 12px;
                                color: Theme.subtle-text;
                                overflow: elide;
                            }
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("../assets/ui/sync.svg");
                        label: "Sync now";
                        enabled: root.can-sync;
                        clicked => {
                            root.sync-now();
                        }
                    }
                    pause-btn := IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("../assets/ui/pause.svg");
                        label: "Pause syncing";
                        clicked => {
                            pause-menu.show({ x: self.absolute-position.x - 160px, y: self.absolute-position.y + self.height + 4px });
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("../assets/ui/settings.svg");
                        label: "Settings and accounts";
                        clicked => {
                            root.settings(-1);
                        }
                    }
                }

                if root.update != "": Rectangle {
                    height: update-row.preferred-height;
                    border-radius: 10px;
                    background: Theme.accent.with-alpha(0.12);
                    update-row := HorizontalLayout {
                        padding: 8px;
                        padding-left: 12px;
                        spacing: 8px;
                        Text {
                            text: "Version " + root.update + " of this app is out.";
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Get it";
                            primary: true;
                            clicked => {
                                root.get-update();
                            }
                        }
                    }
                }

                // ---- accounts
                Rectangle {
                    height: max(1, min(3, root.accounts.length)) * root.acc-row-h + 2px;
                    border-radius: 10px;
                    background: Theme.card;
                    border-width: acc-keys.has-focus ? 2px : 1px;
                    border-color: acc-keys.has-focus ? Theme.accent : Theme.card-border;
                    accessible-role: list;
                    accessible-label: "Accounts";
                    acc-lv := ListView {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        for a[i] in root.accounts: Rectangle {
                            height: root.acc-row-h;
                            background: i == root.acc-current && acc-keys.has-focus ? Theme.selected : ata.has-hover ? Theme.hover : transparent;
                            accessible-role: list-item;
                            accessible-label: a.name + ": " + a.status;
                            accessible-item-index: i;
                            accessible-action-default => {
                                root.settings(i);
                            }
                            ata := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.settings(i);
                                }
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                ToneDot {
                                    tone: a.tone;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: a.name;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    font-weight: 500;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: a.status;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    overflow: elide;
                                    font-size: 12px;
                                    color: a.tone == 2 ? Theme.problem : Theme.subtle-text;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    acc-keys := ListKeys {
                        count: root.accounts.length;
                        row-height: root.acc-row-h;
                        visible-height: acc-lv.visible-height;
                        current <=> root.acc-current;
                        content-y <=> acc-lv.content-y;
                        activated(i) => {
                            root.settings(i);
                        }
                    }
                }

                // ---- not synced (only when there are any)
                if root.blocked.length > 0: SectionTitle {
                    text: "Not synced (" + root.blocked.length + ")";
                    color: Theme.problem;
                }
                if root.blocked.length > 0: FileList {
                    height: min(2, root.blocked.length) * 50px + 2px;
                    rows: root.blocked;
                    empty-text: "";
                    current <=> root.bl-current;
                    open(i) => {
                        root.reveal-blocked(i);
                    }
                    reveal(i) => {
                        root.reveal-blocked(i);
                    }
                }

                // ---- syncing now
                SectionTitle {
                    text: root.transfers.length == 0 ? "Syncing now" : "Syncing now (" + root.transfers.length + ")";
                }
                tr := FileList {
                    height: root.transfers.length == 0 ? 40px : min(3, root.transfers.length) * 50px + 2px;
                    rows: root.transfers;
                    empty-text: "No large files are transferring right now.";
                    current <=> root.tr-current;
                    open(i) => {
                        root.open-file(true, i);
                    }
                    reveal(i) => {
                        root.reveal-file(true, i);
                    }
                }

                // ---- recent
                HorizontalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: "Recent files";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.filters.length > 2: ComboBox {
                        accessible-label: "Show recent files for account";
                        width: 170px;
                        model: root.filters;
                        current-index <=> root.filter;
                        selected => {
                            root.filter-changed();
                        }
                    }
                }
                rec := FileList {
                    vertical-stretch: 1;
                    rows: root.recent;
                    empty-text: "Nothing has synced recently.";
                    current <=> root.rec-current;
                    open(i) => {
                        root.open-file(false, i);
                    }
                    reveal(i) => {
                        root.reveal-file(false, i);
                    }
                }

                // ---- footer
                HorizontalLayout {
                    spacing: 8px;
                    folder-btn := Button {
                        text: "Open folder";
                        icon: @image-url("../assets/ui/folder.svg");
                        colorize-icon: true;
                        horizontal-stretch: 1;
                        enabled: root.accounts.length > 0;
                        clicked => {
                            if (root.accounts.length == 1) {
                                root.open-folder(0);
                            } else {
                                folder-menu.show({ x: self.absolute-position.x, y: max(8px, self.absolute-position.y - root.accounts.length * 32px - 12px) });
                            }
                        }
                    }
                    online-btn := Button {
                        text: "View online";
                        icon: @image-url("../assets/ui/globe.svg");
                        colorize-icon: true;
                        horizontal-stretch: 1;
                        enabled: root.accounts.length > 0;
                        clicked => {
                            online-menu.show({ x: self.absolute-position.x, y: max(8px, self.absolute-position.y - (root.accounts.length == 1 ? 3 : root.accounts.length) * 32px - 12px) });
                        }
                    }
                }
            }
        }

        pause-menu := ContextMenuArea {
            enabled: false; // shown by the pause button only
            Menu {
                MenuItem {
                    title: "Pause for 1 hour";
                    activated => {
                        root.pause(3600);
                    }
                }
                MenuItem {
                    title: "Pause for 4 hours";
                    activated => {
                        root.pause(4 * 3600);
                    }
                }
                MenuItem {
                    title: "Pause until tomorrow morning";
                    activated => {
                        root.pause(-1);
                    }
                }
                if root.any-paused: MenuSeparator { }
                if root.any-paused: MenuItem {
                    title: "Resume syncing";
                    activated => {
                        root.pause(0);
                    }
                }
            }
        }
        folder-menu := ContextMenuArea {
            enabled: false;
            Menu {
                for a[i] in root.accounts: MenuItem {
                    title: a.name;
                    activated => {
                        root.open-folder(i);
                    }
                }
            }
        }
        online-menu := ContextMenuArea {
            enabled: false;
            Menu {
                // one account: its pages; several: a menu per account
                if root.accounts.length == 1: MenuItem {
                    title: "OneDrive website";
                    activated => {
                        root.view-online(0, 0);
                    }
                }
                if root.accounts.length == 1: MenuItem {
                    title: "Recycle bin";
                    activated => {
                        root.view-online(0, 1);
                    }
                }
                if root.accounts.length == 1 && root.accounts[0].personal: MenuItem {
                    title: "Restore your OneDrive";
                    activated => {
                        root.view-online(0, 2);
                    }
                }
                if root.accounts.length > 1: Menu {
                    title: "OneDrive website";
                    for a[i] in root.accounts: MenuItem {
                        title: a.name;
                        activated => {
                            root.view-online(i, 0);
                        }
                    }
                }
                if root.accounts.length > 1: Menu {
                    title: "Recycle bin";
                    for a[i] in root.accounts: MenuItem {
                        title: a.name;
                        activated => {
                            root.view-online(i, 1);
                        }
                    }
                }
                if root.accounts.length > 1: Menu {
                    title: "Restore your OneDrive";
                    for a[i] in root.accounts: MenuItem {
                        title: a.name;
                        enabled: a.personal;
                        activated => {
                            root.view-online(i, 2);
                        }
                    }
                }
            }
        }
    }
}

// ======== a file's own window, opened from the file manager: version history, or sharing
// with particular people (filewin.rs)

export struct VersionRow {
    when: string,
    detail: string, // size and who saved it
}

export component FileWindow inherits Window {
    title: root.mode == 0 ? "Version history — " + root.file-name : "Share — " + root.file-name;
    icon: @image-url("../assets/drivedeck.svg");
    preferred-width: 520px;
    preferred-height: root.mode == 0 ? 560px : 500px;
    min-width: 380px;
    background: Theme.window;
    in property <bool> dark;
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
        Theme.dark = self.dark;
    }
    init => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
        Theme.dark = self.dark;
    }

    in property <int> mode; // 0 version history, 1 share with people
    in property <string> file-name;
    in property <string> account;
    in property <bool> busy;
    in property <string> msg;
    in property <int> msg-tone; // 0 ok, 2 problem, 3 plain
    // version history
    in property <[VersionRow]> versions;
    in-out property <int> confirm: -1; // the version being restored, asking first
    callback open-version(int);
    callback restore-version(int);
    // sharing
    in property <bool> is-work; // only people in the organization (or as the admin allows)
    in-out property <string> emails;
    in-out property <bool> can-edit;
    in-out property <string> message;
    callback send();
    callback close-window();

    VerticalLayout {
        padding: 18px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: Theme.accent.with-alpha(Theme.dark ? 0.25 : 0.14);
                Image {
                    width: 24px;
                    height: 24px;
                    source: root.mode == 0 ? @image-url("../assets/ui/sync.svg") : @image-url("../assets/ui/globe.svg");
                    colorize: Theme.accent;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.mode == 0 ? "Version history" : "Share with people";
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.file-name + "  ·  " + root.account;
                    color: Theme.subtle-text;
                    overflow: elide;
                }
            }
        }

        // ---- version history
        if root.mode == 0: Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 6px;
                if root.busy && root.versions.length == 0: HorizontalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Spinner {
                        indeterminate: true;
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        text: "Getting the saved versions…";
                        vertical-alignment: center;
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for v[i] in root.versions: Rectangle {
                        height: 58px;
                        border-radius: 10px;
                        background: row-touch.has-hover ? Theme.hover : transparent;
                        animate background { duration: Theme.quick; }
                        row-touch := TouchArea { }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 10px;
                            // a timeline: a dot per version, the newest filled
                            Rectangle {
                                width: 12px;
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: 2px;
                                    y: i == 0 ? parent.height / 2 : 0;
                                    height: i == 0 ? parent.height / 2 : (i == root.versions.length - 1 ? parent.height / 2 : parent.height);
                                    background: Theme.track;
                                    visible: root.versions.length > 1;
                                }
                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 6px;
                                    background: i == 0 ? Theme.accent : Theme.card;
                                    border-width: 2px;
                                    border-color: Theme.accent;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: v.when;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    if i == 0: Badge {
                                        text: "Current";
                                        tone: Theme.ok;
                                    }
                                }
                                Text {
                                    text: v.detail;
                                    font-size: 12px;
                                    color: Theme.subtle-text;
                                    overflow: elide;
                                }
                            }
                            // centred, not stretched to the row's height
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Open";
                                        enabled: !root.busy;
                                        clicked => {
                                            root.open-version(i);
                                        }
                                    }
                                    if i > 0: Button {
                                        text: "Restore";
                                        enabled: !root.busy;
                                        clicked => {
                                            root.confirm = i;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if root.mode == 0: Hint {
            text: "\"Open\" saves a copy of that version and opens it, without changing anything. \"Restore\" makes it the current version everywhere; the version it replaces is kept here too, so nothing is lost.";
        }

        // ---- share with people
        if root.mode == 1: Card {
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text {
                    text: "Invite people by email";
                    font-weight: 600;
                }
                LineEdit {
                    accessible-label: "Email addresses to invite";
                    text <=> root.emails;
                    placeholder-text: "name@example.com, another@example.com";
                    input-type: text;
                    enabled: !root.busy;
                }
                Hint {
                    text: root.is-work ? "Separate addresses with commas. Each person gets an email and signs in to open it. People outside your organization can only be added if your IT team allows it." : "Separate addresses with commas. Each person gets an email and signs in with a Microsoft account to open it.";
                }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: "Can edit";
                            font-weight: 600;
                        }
                        Hint {
                            text: root.can-edit ? "They can change it (and add or delete files in a folder)." : "They can view and download it, but not change it.";
                        }
                    }
                    Switch {
                        checked <=> root.can-edit;
                        enabled: !root.busy;
                        accessible-label: "Can edit";
                    }
                }
                Text {
                    text: "Message (optional)";
                    font-weight: 600;
                }
                TextEdit {
                    accessible-label: "Invitation message";
                    text <=> root.message;
                    height: 90px;
                    wrap: word-wrap;
                    enabled: !root.busy;
                }
            }
        }
        if root.mode == 1: Rectangle {
            vertical-stretch: 1;
        }

        // ---- status and buttons
        HorizontalLayout {
            spacing: 10px;
            if root.busy: Spinner {
                indeterminate: true;
                width: 20px;
                height: 20px;
            }
            Text {
                text: root.msg;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: root.msg-tone == 0 ? Theme.ok : root.msg-tone == 2 ? Theme.problem : Theme.subtle-text;
            }
            if root.mode == 1: Button {
                text: "Send invitation";
                primary: true;
                enabled: !root.busy && root.emails != "";
                clicked => {
                    root.send();
                }
            }
            Button {
                text: "Close";
                clicked => {
                    root.close-window();
                }
            }
        }
    }

    // asking before restoring
    if root.confirm >= 0: Overlay {
        width: root.width;
        height: root.height;
        Card {
            width: min(420px, root.width - 40px);
            height: cf-layout.preferred-height;
            background: Theme.dialog;
            border-radius: 14px;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            cf-layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading {
                    text: "Restore this version?";
                    font-size: 16px;
                }
                Text {
                    text: "The version from " + root.versions[root.confirm].when + " becomes the current one, online and on this computer. The current version is kept in the history, so you can switch back.";
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.confirm = -1;
                        }
                    }
                    Button {
                        text: "Restore";
                        primary: true;
                        clicked => {
                            root.restore-version(root.confirm);
                            root.confirm = -1;
                        }
                    }
                }
            }
        }
    }
}
