# Binary-only spec: packaging/build.sh stages the files and passes their location as %{stage}.
Name:           drivedeck
Version:        @VERSION@
Release:        1
Summary:        DriveDeck for OneDrive: the easiest, most complete way to use OneDrive on Linux
License:        GPL-3.0-or-later
URL:            https://github.com/sweatshopking/DriveDeck
# libraries the window opens at runtime (dlopen), which automatic dependency detection can't see
Requires:       libxkbcommon.so.0()(64bit)
Requires:       libEGL.so.1()(64bit)
Requires:       libwayland-client.so.0()(64bit)
Requires:       libwayland-egl.so.1()(64bit)
Requires:       systemd
Requires:       xdg-utils
# the sync engine, installed separately so it keeps getting its own updates
Recommends:     onedrive >= 2.5.0
Recommends:     (kdialog or zenity)
# the app's name before 0.5.0
Provides:       linux-onedrive-gui = %{version}-%{release}
Obsoletes:      linux-onedrive-gui < 0.5.0

%global debug_package %{nil}
# the Dolphin plugin only works with Plasma 6 and must not pull KDE onto other desktops
%global __requires_exclude_from ^/usr/lib64/qt6/plugins/.*$
%global __strip /bin/true

%description
A friendly front end for the OneDrive Client for Linux (abraunegg/onedrive),
which does the syncing and is installed separately. Sign in, choose folders,
set sync times, pause, see what synced and share links, without using the
command line.

%install
cp -a %{stage}/. %{buildroot}/

%files
%license /usr/share/licenses/drivedeck/LICENSE
%doc /usr/share/doc/drivedeck/THIRD-PARTY.md
/usr/bin/drivedeck
/usr/bin/linux-onedrive-gui
/usr/libexec/drivedeck/install-client
/usr/share/polkit-1/actions/io.github.sweatshopking.DriveDeck.policy
/usr/share/applications/drivedeck.desktop
/usr/share/metainfo/io.github.sweatshopking.DriveDeck.metainfo.xml
/usr/share/icons/hicolor/scalable/apps/drivedeck.svg
/usr/share/icons/hicolor/256x256/apps/drivedeck.png
/usr/share/icons/hicolor/scalable/status/drivedeck-*.svg
/usr/share/kio/servicemenus/drivedeck.desktop
@PLUGIN@
