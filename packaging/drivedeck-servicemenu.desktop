[Desktop Entry]
Type=Service
MimeType=application/octet-stream;inode/directory;
Actions=sharePeople;copyLink;copyEditLink;versions;viewOnline;
X-KDE-Submenu=OneDrive
X-KDE-Priority=TopLevel
Icon=drivedeck

[Desktop Action sharePeople]
Name=Share with people…
Icon=document-share
Exec=drivedeck --share-people %f

[Desktop Action copyLink]
Name=Copy view-only link
Icon=edit-link
Exec=drivedeck --share-link %f

[Desktop Action copyEditLink]
Name=Copy editing link
Icon=document-edit
Exec=drivedeck --share-edit-link %f

[Desktop Action versions]
Name=Version history
Icon=view-history
Exec=drivedeck --versions %f

[Desktop Action viewOnline]
Name=View on the OneDrive website
Icon=internet-web-browser
Exec=drivedeck --view-online %f
