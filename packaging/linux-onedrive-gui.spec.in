# Binary-only spec: packaging/build.sh stages the files and passes their location as %{stage}.
Name:           linux-onedrive-gui
Version:        @VERSION@
Release:        1
Summary:        OneDrive and SharePoint sync with a tray icon and settings window
License:        GPL-3.0-or-later
URL:            https://github.com/sweatshopking/A-GUI-that-works-with-OneDrive-on-Linux-unofficial
# libraries the window opens at runtime (dlopen), which automatic dependency detection can't see
Requires:       libxkbcommon.so.0()(64bit)
Requires:       libEGL.so.1()(64bit)
Requires:       libwayland-client.so.0()(64bit)
Requires:       libwayland-egl.so.1()(64bit)
Requires:       systemd
Requires:       xdg-utils
# the sync engine, installed separately so it keeps getting its own updates
Recommends:     onedrive >= 2.5.0
Recommends:     (kdialog or zenity)

%global debug_package %{nil}
%global __strip /bin/true

%description
A friendly front end for the OneDrive Client for Linux (abraunegg/onedrive),
which does the syncing and is installed separately. Sign in, choose folders,
set sync times, pause, see what synced and share links, without using the
command line.

%install
cp -a %{stage}/. %{buildroot}/

%files
%license /usr/share/licenses/linux-onedrive-gui/LICENSE
%doc /usr/share/doc/linux-onedrive-gui/THIRD-PARTY.md
/usr/bin/linux-onedrive-gui
/usr/libexec/linux-onedrive-gui/install-client
/usr/share/polkit-1/actions/io.github.sweatshopking.LinuxOnedriveGui.policy
/usr/share/applications/linux-onedrive-gui.desktop
/usr/share/metainfo/io.github.sweatshopking.LinuxOnedriveGui.metainfo.xml
/usr/share/icons/hicolor/scalable/apps/linux-onedrive-gui.svg
/usr/share/icons/hicolor/256x256/apps/linux-onedrive-gui.png
/usr/share/icons/hicolor/scalable/status/linux-onedrive-gui-*.svg
/usr/share/kio/servicemenus/linux-onedrive-gui.desktop
