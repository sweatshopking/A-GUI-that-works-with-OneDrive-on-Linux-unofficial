#!/bin/sh
# Installs or updates the OneDrive Client for Linux for drivedeck. Runs as root through
# pkexec: as /usr/libexec/drivedeck/install-client when the app came as a .deb or .rpm
# (its polkit action words the password prompt), otherwise handed to /bin/sh by the app.
#   install-client apt <release folder>  Ubuntu/Debian: the client author's package source,
#                                        e.g. xUbuntu_24.04 or Debian_12
#   install-client aur                   Arch: build the AUR recipe, then install it
#   install-client dnf | zypper          the distribution's own package
# Lines starting with "STEP " are the progress the app shows; everything else is for the log.
set -eu
step() { echo "STEP $*"; }

# Whether the client's package source for release $1 is set up, and switched on, somewhere other
# than our own onedrive.list. Software & Updates switches a source off by commenting out its line
# (.list) or with "Enabled: no" in its stanza (.sources); backups like .list.save don't count.
source_in_use() {
    pat="npreining:/debian-ubuntu-onedrive/$1"
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list; do
        [ -f "$f" ] && [ "$f" != /etc/apt/sources.list.d/onedrive.list ] &&
            grep -qsE "^[[:space:]]*deb[[:space:]].*$pat" "$f" && return 0
    done
    for f in /etc/apt/sources.list.d/*.sources; do
        [ -f "$f" ] && awk -v pat="$pat" 'BEGIN { RS = "" }
            { on = 1; has = 0; n = split($0, l, "\n")
              for (i = 1; i <= n; i++) {
                  if (l[i] ~ /^[ \t]*Enabled:[ \t]*[Nn][Oo]/) on = 0
                  if (l[i] ~ /^[ \t]*URIs:/ && index(l[i], pat)) has = 1
              }
              if (on && has) found = 1 }
            END { exit !found }' "$f" && return 0
    done
    return 1
}

apt_install() {
    case "$1" in
    xUbuntu_[0-9][0-9].[0-9][0-9] | Debian_[0-9][0-9]) ;;
    *) echo "Unknown release: $1" >&2; exit 2 ;;
    esac
    export DEBIAN_FRONTEND=noninteractive
    repo="https://download.opensuse.org/repositories/home:/npreining:/debian-ubuntu-onedrive/$1/"
    wait="-o DPkg::Lock::Timeout=300"
    # Someone who followed the guide by hand already has the source; a second copy would break apt.
    if source_in_use "$1"; then
        step "The client's package source is already set up."
    else
        step "Adding the OneDrive client's package source…"
        tmp="$(mktemp)"
        trap 'rm -f "$tmp"' EXIT
        if [ -x /usr/lib/apt/apt-helper ]; then
            /usr/lib/apt/apt-helper download-file "${repo}Release.key" "$tmp"
        elif command -v curl >/dev/null; then
            curl -fsSL "${repo}Release.key" -o "$tmp"
        else
            wget -qO "$tmp" "${repo}Release.key"
        fi
        grep -q "BEGIN PGP PUBLIC KEY BLOCK" "$tmp" || { echo "The package source's signing key didn't download correctly." >&2; exit 1; }
        # apt reads a key in text form only from a .asc file; gpg turns it into the guide's .gpg file
        if command -v gpg >/dev/null; then
            key=/usr/share/keyrings/obs-onedrive.gpg
            gpg --dearmor --yes -o "$key" "$tmp"
        else
            key=/usr/share/keyrings/obs-onedrive.asc
            cp "$tmp" "$key"
        fi
        chmod 644 "$key"
        echo "deb [arch=$(dpkg --print-architecture) signed-by=$key] $repo ./" > /etc/apt/sources.list.d/onedrive.list
    fi
    # A system-wide "start at login" for the client (an admin's choice, or left by an older onedrive
    # package) is never changed here: the app reports it and switches it off only when asked.
    step "Checking for packages…"
    # the lock timeout may not cover the package lists, which the desktop's updater refreshes;
    # any other failure is reported straight away
    tries=1
    while ! out="$(apt-get $wait update 2>&1)"; do
        if [ "$tries" -lt 3 ] && printf '%s\n' "$out" | grep -q "Could not get lock"; then
            tries=$((tries + 1))
            step "Waiting for another software update to finish…"
            sleep 30
        else
            printf '%s\n' "$out"
            exit 1
        fi
    done
    printf '%s\n' "$out"
    step "Installing the OneDrive client…"
    apt-get $wait install -y --no-install-recommends --no-install-suggests onedrive
}

# makepkg refuses to run as root. The recipe is built by a throwaway account systemd makes for
# this one build (DynamicUser), in a folder only it and root can reach, so what gets installed is
# exactly what the recipe built: no one else, including the person asking (who may not be the
# admin typing the password), can change it in between. Where systemd can't do that, "nobody"
# builds it.
aur_install() {
    # a repository that already has it built (Chaotic-AUR and the like): signed, and much faster
    if pacman -Si onedrive-abraunegg >/dev/null 2>&1; then
        step "Installing the OneDrive client…"
        pacman -S --needed --noconfirm onedrive-abraunegg
        return
    fi
    step "Installing the tools needed to build the client…"
    if ! pacman -S --needed --noconfirm base-devel ldc libnotify sqlite dbus curl; then
        echo "Couldn't install the build tools. Update your system (pacman -Syu, or your update app) and try again." >&2
        exit 1
    fi
    if [ -d /run/systemd/system ] &&
        systemd-run --quiet --wait --pipe --collect -p DynamicUser=yes true >/dev/null 2>&1; then
        name="drivedeck-build-$$"
        dir="/var/lib/$name" # the account's StateDirectory; really /var/lib/private/$name
        trap 'rm -rf "/var/lib/private/$name" "/var/lib/$name"' EXIT
        isolate() {
            systemd-run --quiet --wait --pipe --collect -p DynamicUser=yes -p StateDirectory="$name" \
                -p WorkingDirectory="$dir" "$@"
        }
    else
        dir="$(mktemp -d)"
        trap 'rm -rf "$dir"' EXIT
        chown nobody "$dir"
        isolate() { runuser -u nobody -- "$@"; }
    fi
    # its own folders for everything, whatever makepkg.conf says
    as_builder() {
        isolate env HOME="$dir" PKGDEST="$dir/out" SRCDEST="$dir/src" BUILDDIR="$dir/build" \
            LOGDEST="$dir/log" "$@"
    }
    step "Downloading the recipe from the AUR…"
    as_builder sh -c 'curl -fsSL -o "$1/recipe.tar.gz" "$2" && tar -xzf "$1/recipe.tar.gz" -C "$1"' \
        sh "$dir" "https://aur.archlinux.org/cgit/aur.git/snapshot/onedrive-abraunegg.tar.gz"
    # anything the recipe needs now that the list above doesn't cover
    missing="$(sed -n 's/^[[:space:]]*\(make\)\{0,1\}depends = //p' "$dir/onedrive-abraunegg/.SRCINFO" \
        | xargs -r pacman -T -- || true)"
    if [ -n "$missing" ]; then
        step "Installing what the client needs…"
        # one name per word, never read as an option or a file pattern
        set -f
        # shellcheck disable=SC2086
        pacman -S --needed --noconfirm -- $missing
        set +f
    fi
    step "Building the client (this takes a few minutes)…"
    as_builder sh -c 'mkdir -p "$PKGDEST" "$SRCDEST" "$BUILDDIR" "$LOGDEST" &&
        cd "$1/onedrive-abraunegg" && makepkg --noconfirm --cleanbuild' sh "$dir"
    step "Installing the OneDrive client…"
    # [0-9]: not the -debug package makepkg also makes by default
    pacman -U --noconfirm "$dir"/out/onedrive-abraunegg-[0-9]*.pkg.tar.*
}

case "${1:-}" in
apt) apt_install "${2:-}" ;;
aur) aur_install ;;
dnf)
    step "Installing the OneDrive client…"
    dnf install -y onedrive
    ;;
zypper)
    step "Installing the OneDrive client…"
    zypper --non-interactive install onedrive
    ;;
*)
    echo "usage: install-client apt <release> | aur | dnf | zypper" >&2
    exit 2
    ;;
esac
