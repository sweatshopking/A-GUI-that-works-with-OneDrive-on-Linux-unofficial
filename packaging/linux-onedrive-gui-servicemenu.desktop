[Desktop Entry]
Type=Service
MimeType=application/octet-stream;inode/directory;
Actions=copyLink;viewOnline;
X-KDE-Submenu=OneDrive
X-KDE-Priority=TopLevel
Icon=linux-onedrive-gui

[Desktop Action copyLink]
Name=Copy sharing link
Icon=edit-link
Exec=linux-onedrive-gui --share-link %f

[Desktop Action viewOnline]
Name=View on the OneDrive website
Icon=internet-web-browser
Exec=linux-onedrive-gui --view-online %f
