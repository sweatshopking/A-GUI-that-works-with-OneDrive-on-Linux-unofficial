<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Words the password prompt for "Install it for me" in a way people recognise, instead of
     showing the installer script. The .deb and .rpm install this; the AppImage can't. -->
<policyconfig>
  <vendor>A GUI that works with OneDrive on Linux (unofficial)</vendor>
  <vendor_url>https://github.com/sweatshopking/A-GUI-that-works-with-OneDrive-on-Linux-unofficial</vendor_url>
  <icon_name>linux-onedrive-gui</icon_name>
  <action id="io.github.sweatshopking.LinuxOnedriveGui.install-client">
    <description>Install or update the OneDrive Client for Linux</description>
    <message>To install or update the OneDrive client, which does the syncing, enter your password.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/linux-onedrive-gui/install-client</annotate>
  </action>
</policyconfig>
